[ T i t l e ]
Sample input for dose calculation for photon therapy

[ P a r a m e t e r s ]
 icntl    =           0     # (D=0) 3:ECH 5:NOR 6:SRC 7,8:GSH 11:DSH 12:DUMP
 maxcas   =        1000     # (D=10) number of particles per one batch
 maxbch   =           2     # (D=10) number of batches
 negs     =           1     # (D=0) =1 EGS photon and electron
 file(1)  = c:/phits        # (D=c:/phits) PHITS install folder name

[ S o u r c e ]
    set:c1[100]  $ radius
    set:c2[3]    $ depth
   s-type =   4             # axial source with energy distribution
     proj =   photon        # 
       r0 =   c1            # radius [cm]
       x0 =   0.0000        # (D=0.0) center position of x-axis [cm]
       y0 =   0.0000        # (D=0.0) center position of y-axis [cm]
       z0 =  -c2            # minimum position of z-axis [cm]
       z1 =  -0.0001        # maximum position of z-axis [cm]
      dir =   all           # isootropic source 
   e-type =   28            # Energy distribution. 28 means RI soource
       ni =   1
     241Am    10*c2*pi*c1**2  $ activity is 10 Bq/cm^3

[ M a t e r i a l ]
MAT[ 1 ]   # Air D = 1.21e-3 g/cm3
           H     7.199E-09
           C     7.585E-09
           N     3.910E-05
           O     1.054E-05

MAT[ 2 ]   # Soil D = 2.1 g/cm3
           H     -0.023       
           C     -0.0023
           O     -1.22
           Na    -0.0368
           Mg    -0.005
           Al    -0.078
           Si    -0.775
           K     -0.0299
           Ca    -0.1
           Fe    -0.032


[ C e l l ]
1           2 -2.1              -1       -999  $ Soil
98          1 -1.21e-3           1       -999  $ Air
99         -1                             999  $ Outer region

[ S u r f a c e ]
 1            rcc      0     0      -10      0      0    10    1000
 999          so   1000.0

[ T - T r a c k ]
    title = [t-track] in xyz mesh
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin =  -100.0000      # minimum value of x-mesh points
     xmax =   100.0000      # maximum value of x-mesh points
       nx =  100            # number of x-mesh points
   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin =  -100.0000      # minimum value of y-mesh points
     ymax =   100.0000      # maximum value of y-mesh points
       ny =    1            # number of y-mesh points
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =  -10.0000      # minimum value of z-mesh points
     zmax =   100.0000      # maximum value of z-mesh points
       nz =  110            # number of z-mesh points
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
            1.00000E-10  1.00000E+03
     unit =    1            # unit is [1/cm^2/source]
 material =  all            # (D=all) number of specific material
  2D-type =    7            # 1:Cont, 2:Clust, 3:Color, 4:xyz, 5:mat, 6:Clust+Cont, 7:Col+Cont
     axis =   xz            # axis of output
     file = track-xyz.out    # file name of output for the above axis
     part =  all

[ T - T r a c k ]
    title = [t-track] in xyz mesh
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin = -100.00000      # minimum value of x-mesh points
     xmax =  100.00000      # maximum value of x-mesh points
       nx =  100            # number of x-mesh points
   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin = -100.00000      # minimum value of y-mesh points
     ymax =  100.00000      # maximum value of y-mesh points
       ny =    1            # number of y-mesh points
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =  -10.00000      # minimum value of z-mesh points
     zmax =   100.0000      # maximum value of z-mesh points
       nz =   110           # number of z-mesh points
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
            1.00000E-10  1.00000E+03
     unit =    1            # unit is [1/cm^2/source]
 material =  all            # (D=all) number of specific material
  2D-type =    3            # 1:Cont, 2:Clust, 3:Color, 4:xyz, 5:mat, 6:Clust+Cont, 7:Col+Cont
     axis =   xz            # axis of output
     file = dose-dist.out   # file name of output for the above axis
     part =  all
   epsout =    1   
   factor = 1e-6*3600       # [pSv/sec] -> [uSv/h]
  multiplier = all          # number of material group
      mat      mset1
      all ( 1.0 -203 )

[END]

