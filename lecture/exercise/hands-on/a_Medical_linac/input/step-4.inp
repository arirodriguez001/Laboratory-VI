[ T i t l e ]
Sample input for dose calculation for photon therapy

[ P a r a m e t e r s ]
 icntl    =           8     # (D=0) 3:ECH 5:NOR 6:SRC 7,8:GSH 11:DSH 12:DUMP
 maxcas   =        1000     # (D=10) number of particles per one batch
 maxbch   =           2     # (D=10) number of batches
 ipnint   =           1     # (D=0) 0: no, 1: consider photo-nuclear reaction
 negs     =           1     # (D=0) =1 EGS photon and electron
 file(1)  = c:/phits        # (D=c:/phits) PHITS install folder name

[ S o u r c e ]
   s-type =   1             # mono-energetic axial source
     proj =  electron       # kind of incident nucleus          
       e0 =   20.000        # energy of beam [MeV/u]
       r0 =   0.1000        # radius [cm]
       x0 =   0.0000        # (D=0.0) center position of x-axis [cm]
       y0 =   0.0000        # (D=0.0) center position of y-axis [cm]
       z0 =  -20.000        # minimum position of z-axis [cm]
       z1 =  -20.000        # maximum position of z-axis [cm]
      dir =   1.0000        # z-direction of beam [cosine]

[ M a t e r i a l ]
MAT[ 1 ]   # ICRU soft tissue
            H         6.0820000E-02
            C         5.5700000E-03
            N         1.1180000E-03
            O         2.8680000E-02

MAT[ 2 ]   # X-ray generator 
            W         1.0

MAT[ 3 ]   # X-ray collimator
           Pb         1.0

$   Concrete   2.302 g/cm^3, taken from ANL-5800 Type 02-a
$   Note: 2.302 g/cm^3 is US standard. There is no Japanese standard value,
$   but 2.1 g/cm^3 is usually used for shielding calculation
MAT[ 4 ] H     -0.023       
         C     -0.0023
         O     -1.22
         Na    -0.0368
         Mg    -0.005
         Al    -0.078
         Si    -0.775
         K     -0.0299
         Ca    -0.1
         Fe    -0.032

[ C e l l ]
 1          2 -17.6 1 -2 -11    $ X-ray generator
 2          1 -1.0  3 -4 -12    $ Phantom
 3          3 -11.3 5 -6 -14 13 $ X-ray collimator
 4          4 -2.1  -21 20      $ Shielding
98          0      #1 #2 #3 #4 -999   $ Void
99         -1             999   $ Outer region

[ S u r f a c e ]
 1            pz     0.0
 2            pz     1.0
 3            pz     5.0
 4            pz    15.0
 5            pz     2.0
 6            pz     4.0
 11           cz     1.0
 12           cz     5.0
 13           cz     0.7
 14           cz     6.0
 20           RPP   -20   20    -20   20   -20   60
 21           RPP   -30   30    -30   30   -30   70
 999          so   100.0

[ T - D e p o s i t ]
    title = Deposit in xyz mesh
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin =  -5.000000*8    # minimum value of x-mesh points
     xmax =   5.000000*8    # maximum value of x-mesh points
       nx =   50            # number of x-mesh points
   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin =  -5.000000*8    # minimum value of y-mesh points
     ymax =   5.000000*8    # maximum value of y-mesh points
       ny =    1            # number of y-mesh points
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =   -2.00000*8    # minimum value of z-mesh points
     zmax =   22.00000*8    # maximum value of z-mesh points
       nz =   120           # number of z-mesh points
     unit =    0            # unit is [Gy/source]
  2D-type =    3            # 1:Cont, 2:Clust, 3:Color, 4:xyz, 5:mat, 6:Clust+Cont, 7:Col+Cont
     axis =   xz            # axis of output
     file = deposit.out     # file name of output for the above axis
 material =  all            # (D=all) number of specific material
   output = dose            # only heat is written
   epsout =    1            # (D=0) generate eps file by ANGEL
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat

[ T - T r a c k ]
    title = Track in xyz mesh
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin =  -5.000000*8    # minimum value of x-mesh points
     xmax =   5.000000*8    # maximum value of x-mesh points
       nx =   50            # number of x-mesh points
   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin =  -5.000000*8    # minimum value of y-mesh points
     ymax =   5.000000*8    # maximum value of y-mesh points
       ny =    1            # number of y-mesh points
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =   -2.00000*8    # minimum value of z-mesh points
     zmax =   16.00000*8    # maximum value of z-mesh points
       nz =   90            # number of z-mesh points
  2D-type =    3            # 1:Cont, 2:Clust, 3:Color, 4:xyz, 5:mat, 6:Clust+Cont, 7:Col+Cont
     axis =   xz            # axis of output
     file = track.out       # file name of output for the above axis
     part = electron photon neutron
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
             0.0  1000.0
     unit =    1            # unit is [1/cm^2/source]
   epsout =    1            # (D=0) generate eps file by ANGEL   
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat

[END]

