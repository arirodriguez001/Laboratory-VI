[ T-Cross ]
    title = [t-cross] in region mesh
     mesh =  reg            # mesh type is region-wise
      reg =    1            # number of crossing regions
      non     r-from  r-to     area
      1       1       2        1.000000    
   e-type =    2            # e-mesh is linear given by emin, emax and ne
     emin =   0.000000      # minimum value of e-mesh points
     emax =   3.000000      # maximum value of e-mesh points
#    edel =  0.1000000      # mesh width of e-mesh points
       ne =     30          # number of e-mesh points
#    data = ( e(i), i = 1, ne + 1 )
#           0.00000E+00  1.00000E-01  2.00000E-01  3.00000E-01  4.00000E-01
#           5.00000E-01  6.00000E-01  7.00000E-01  8.00000E-01  9.00000E-01
#           1.00000E+00  1.10000E+00  1.20000E+00  1.30000E+00  1.40000E+00
#           1.50000E+00  1.60000E+00  1.70000E+00  1.80000E+00  1.90000E+00
#           2.00000E+00  2.10000E+00  2.20000E+00  2.30000E+00  2.40000E+00
#           2.50000E+00  2.60000E+00  2.70000E+00  2.80000E+00  2.90000E+00
#           3.00000E+00
     unit =    1            # unit is [1/cm^2/source]
     axis =  eng            # axis of output
     file = cross.out       # file name of output for the above axis
   output = flux            # surface crossing flux
     part =  photon     electron   alpha      neutron  
# kf/name :  22         11         2000004    2112     
   epsout =    2            # (D=0) generate eps file by ANGEL
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :          44 (  0)           0 (  0)          44 (  0)

#------------------------------------------------------------------------------
#newpage:
#   no. =    1   reg = 1 - 2

x: Energy [MeV]
y:   Flux  [1/cm^2/source]                 
p: xlin ylog afac(0.8) form(0.9)
h: n            x            y1(photon  ),hh0l   ny5 dy1=[y1*y5] y2(electron),hh0dr  ny6 dy2=[y2*y6] y3(alpha   ),hh0ub  ny7 dy3=[y3*y7] y4(neutron ),hh0mg  ny8 dy4=[y4*y8] 
