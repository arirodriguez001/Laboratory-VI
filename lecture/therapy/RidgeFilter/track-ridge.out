#          -4.61000E+01 -4.60300E+01 -4.59600E+01 -4.58900E+01 -4.58200E+01
#          -4.57500E+01 -4.56800E+01 -4.56100E+01 -4.55400E+01 -4.54700E+01
#          -4.54000E+01 -4.53300E+01 -4.52600E+01 -4.51900E+01 -4.51200E+01
