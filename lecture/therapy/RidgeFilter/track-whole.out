[ T-Track ]
    title = Track in xyz mesh
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin =  -20.00000      # minimum value of x-mesh points
     xmax =   20.00000      # maximum value of x-mesh points
#    xdel =   1.000000      # mesh width of x-mesh points
       nx =     40          # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
#          -2.00000E+01 -1.90000E+01 -1.80000E+01 -1.70000E+01 -1.60000E+01
#          -1.50000E+01 -1.40000E+01 -1.30000E+01 -1.20000E+01 -1.10000E+01
#          -1.00000E+01 -9.00000E+00 -8.00000E+00 -7.00000E+00 -6.00000E+00
#          -5.00000E+00 -4.00000E+00 -3.00000E+00 -2.00000E+00 -1.00000E+00
#           0.00000E+00  1.00000E+00  2.00000E+00  3.00000E+00  4.00000E+00
#           5.00000E+00  6.00000E+00  7.00000E+00  8.00000E+00  9.00000E+00
#           1.00000E+01  1.10000E+01  1.20000E+01  1.30000E+01  1.40000E+01
#           1.50000E+01  1.60000E+01  1.70000E+01  1.80000E+01  1.90000E+01
#           2.00000E+01
   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin =  -20.00000      # minimum value of y-mesh points
     ymax =   20.00000      # maximum value of y-mesh points
#    ydel =   40.00000      # mesh width of y-mesh points
       ny =      1          # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
#          -2.00000E+01  2.00000E+01
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =  -110.0000      # minimum value of z-mesh points
     zmax =   40.00000      # maximum value of z-mesh points
#    zdel =   1.000000      # mesh width of z-mesh points
       nz =    150          # number of z-mesh points
#    data = ( z(i), i = 1, nz + 1 )
#          -1.10000E+02 -1.09000E+02 -1.08000E+02 -1.07000E+02 -1.06000E+02
#          -1.05000E+02 -1.04000E+02 -1.03000E+02 -1.02000E+02 -1.01000E+02
#          -1.00000E+02 -9.90000E+01 -9.80000E+01 -9.70000E+01 -9.60000E+01
#          -9.50000E+01 -9.40000E+01 -9.30000E+01 -9.20000E+01 -9.10000E+01
#          -9.00000E+01 -8.90000E+01 -8.80000E+01 -8.70000E+01 -8.60000E+01
#          -8.50000E+01 -8.40000E+01 -8.30000E+01 -8.20000E+01 -8.10000E+01
#          -8.00000E+01 -7.90000E+01 -7.80000E+01 -7.70000E+01 -7.60000E+01
#          -7.50000E+01 -7.40000E+01 -7.30000E+01 -7.20000E+01 -7.10000E+01
#          -7.00000E+01 -6.90000E+01 -6.80000E+01 -6.70000E+01 -6.60000E+01
#          -6.50000E+01 -6.40000E+01 -6.30000E+01 -6.20000E+01 -6.10000E+01
#          -6.00000E+01 -5.90000E+01 -5.80000E+01 -5.70000E+01 -5.60000E+01
#          -5.50000E+01 -5.40000E+01 -5.30000E+01 -5.20000E+01 -5.10000E+01
#          -5.00000E+01 -4.90000E+01 -4.80000E+01 -4.70000E+01 -4.60000E+01
#          -4.50000E+01 -4.40000E+01 -4.30000E+01 -4.20000E+01 -4.10000E+01
#          -4.00000E+01 -3.90000E+01 -3.80000E+01 -3.70000E+01 -3.60000E+01
#          -3.50000E+01 -3.40000E+01 -3.30000E+01 -3.20000E+01 -3.10000E+01
#          -3.00000E+01 -2.90000E+01 -2.80000E+01 -2.70000E+01 -2.60000E+01
#          -2.50000E+01 -2.40000E+01 -2.30000E+01 -2.20000E+01 -2.10000E+01
#          -2.00000E+01 -1.90000E+01 -1.80000E+01 -1.70000E+01 -1.60000E+01
#          -1.50000E+01 -1.40000E+01 -1.30000E+01 -1.20000E+01 -1.10000E+01
#          -1.00000E+01 -9.00000E+00 -8.00000E+00 -7.00000E+00 -6.00000E+00
#          -5.00000E+00 -4.00000E+00 -3.00000E+00 -2.00000E+00 -1.00000E+00
#           0.00000E+00  1.00000E+00  2.00000E+00  3.00000E+00  4.00000E+00
#           5.00000E+00  6.00000E+00  7.00000E+00  8.00000E+00  9.00000E+00
#           1.00000E+01  1.10000E+01  1.20000E+01  1.30000E+01  1.40000E+01
#           1.50000E+01  1.60000E+01  1.70000E+01  1.80000E+01  1.90000E+01
#           2.00000E+01  2.10000E+01  2.20000E+01  2.30000E+01  2.40000E+01
#           2.50000E+01  2.60000E+01  2.70000E+01  2.80000E+01  2.90000E+01
#           3.00000E+01  3.10000E+01  3.20000E+01  3.30000E+01  3.40000E+01
#           3.50000E+01  3.60000E+01  3.70000E+01  3.80000E+01  3.90000E+01
#           4.00000E+01
   e-type =    1            # e-mesh is given by the below data
       ne =      1          # number of e-mesh points
#    data = ( e(i), i = 1, ne + 1 )
            0.00000E+00  1.00000E+03
     unit =    1            # unit is [1/cm^2/source]
 material =  all            # (D=all) number of specific material
  2D-type =    3            # 1:Cont, 2:Clust, 3:Color, 4:xyz, 5:mat, 6:Clust+Cont, 7:Col+Cont
     axis =      xz            # axis of output
     file = track-whole.out  # file name of output for the above axis
     part =  proton     neutron  
# kf/name :  2212       2112     
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat 5:bmp style
    resol =    2            # (D=1) resolution of gshow or rshow
    width = 0.5000000       # (D=0.5) width of lines for gshow or rshow
   epsout =    1            # (D=0) generate eps file by ANGEL
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :         200 (  0)           0 (  0)         200 (  0)

#------------------------------------------------------------------------------
#newpage:
#   no. =  1   ie  =  1   iy  =  1   part. = proton  
#   e = (   0.0000E+00  -   1.0000E+03  )
#   y = (  -2.0000E+01  -   2.0000E+01  )

'no. =  1,  ie =  1,  iy =  1'
msuc: {\huge Track in xyz mesh}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.26}

x: z [cm]
y: x [cm]
set: c1[ 0.267] c2[ 1.743] c5[ 0.800] c6[ 0.630] c7[ 0.000] c8[ 1.100]
p: h2fs form[c1] xfac[c2] afac[c5] scal[c6] xorg[c7] yorg[c8] nosp
p: xmin( -110.0000    ) xmax(  40.00000    )
p: ymin( -20.00000    ) ymax(  20.00000    )
#  nx =  40   nz = 150
# ( ( data(z,x), z = 1, nz ), x = nx, 1, -1 )

#------------------------------------------------------------------------------
# gshow
#------------------------------------------------------------------------------

p: legs[c5*0.875]

h: x ny1,0  y2=[y1](Air),ic[lightgray]
 -1.000000E+00 -1.000000E+00

hb:   line clip z   cb(lightgray)
