[ T-Track ]
    title = [t-track] in r-z mesh
     mesh =  r-z            # mesh type is r-z scoring mesh
       x0 =   0.000000      # center x-position of r-z mesh
       y0 =   0.000000      # center y-position of r-z mesh
   r-type =    2            # r-mesh is linear given by rmin, rmax and nr
     rmin =   0.000000      # minimum value of r-mesh points
     rmax =   10.00000      # maximum value of r-mesh points
#    rdel =   10.00000      # mesh width of r-mesh points
       nr =      1          # number of r-mesh points
#    data = ( r(i), i = 1, nr + 1 )
#           0.00000E+00  1.00000E+01
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =   0.000000      # minimum value of z-mesh points
     zmax =   10.00000      # maximum value of z-mesh points
#    zdel =   1.000000      # mesh width of z-mesh points
       nz =     10          # number of z-mesh points
#    data = ( z(i), i = 1, nz + 1 )
#           0.00000E+00  1.00000E+00  2.00000E+00  3.00000E+00  4.00000E+00
#           5.00000E+00  6.00000E+00  7.00000E+00  8.00000E+00  9.00000E+00
#           1.00000E+01
   e-type =    1            # e-mesh is given by the below data
       ne =      1          # number of e-mesh points
#    data = ( e(i), i = 1, ne + 1 )
            0.00000E+00  1.00000E+03
     unit =    1            # unit is [1/cm^2/source]
 material =  all            # (D=all) number of specific material
     axis =       z            # axis of output
     file = nitro.out       # file name of output for the above axis
     part =  neutron  
# kf/name :  2112     
  multiplier = all          # number of material group
     part =  neutron  
# kf/name :  2112     
     emax =    20.000    
      mat                   mset1  
      all ( 1.79077E-13 2002 1 -4 )
    angel = ymin(1.0e-17) ymax(1.0e-14)
    y-txt = Dose [Gy/source]
   epsout =    1            # (D=0) generate eps file by ANGEL
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :          38 (  0)           0 (  0)          38 (  0)

#------------------------------------------------------------------------------
#newpage:
#   no. =  1   ie  =  1   ir  =  1
#   e = (   0.0000E+00  -   1.0000E+03  )
#   r = (   0.0000E+00  -   1.0000E+01  )
#   mset =  1

x: z [cm]
y: Dose [Gy/source]
p: xlin ylog afac(0.8) form(0.9)
p: ymin(1.0e-17) ymax(1.0e-14)
h: n            x            y(neutron ),hh0l n  
#  z-lower      z-upper        neutron   r.err 
   0.0000E+00   1.0000E+00   9.0568E-16  0.0333
   1.0000E+00   2.0000E+00   1.4413E-15  0.0340
   2.0000E+00   3.0000E+00   1.5142E-15  0.0368
   3.0000E+00   4.0000E+00   1.2636E-15  0.0415
   4.0000E+00   5.0000E+00   9.7023E-16  0.0494
   5.0000E+00   6.0000E+00   6.3898E-16  0.0574
   6.0000E+00   7.0000E+00   4.5308E-16  0.0713
   7.0000E+00   8.0000E+00   2.5584E-16  0.0855
   8.0000E+00   9.0000E+00   1.4691E-16  0.1064
   9.0000E+00   1.0000E+01   5.8705E-17  0.1233

#   sum over    3.1416E+03   7.6485E-16

'no. =  1,  ie =  1,  ir =  1,  mset =  1'
msuc: {\huge [t-track] in r-z mesh}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.33}
wt: s(0.7)
\vspace{-3}
  emin  &=&   0.0000E+00 [MeV]
  emax  &=&   1.0000E+03 [MeV]
  rmin  &=&   0.0000E+00 [cm]
  rmax  &=&   1.0000E+01 [cm]
  mset  &=&   1
e:
 
# Information for Restart Calculation
# This calculation was newly started
# istdev =  2 # 1:Batch variance, 2:History variance
# resc2  = 2.00000000000000000E+03 # Total source weight or Total source weight / maxcas
# resc3  = 2.00000000000000000E+03 # Total history number or Total batch number
# maxcas =        1000 # History / Batch, only used for istdev=1
# bitrseed = 0101100011011011110001100101110111100110110100101110100101001100 # bit data of rseed
