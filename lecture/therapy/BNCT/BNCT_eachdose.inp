[ T i t l e ]
Sample input for BNCT calculation

[ P a r a m e t e r s ]
 icntl    =           0     # (D=0) 3:ECH 5:NOR 6:SRC 7,8:GSH 11:DSH 12:DUMP
$ ireschk  =           1     # (D=0) Restart calculation check
 maxcas   =        1000     # (D=10) number of particles per one batch
 maxbch   =           10     # (D=10) number of batches

[ S o u r c e ]
   s-type =   1             # mono-energetic axial source
     proj =  neutron        # kind of incident nucleus          
       e0 =   1.0e-5        # energy of beam [MeV/u]
       r0 =   10.000        # radius [cm]
       x0 =   0.0000        # (D=0.0) center position of x-axis [cm]
       y0 =   0.0000        # (D=0.0) center position of y-axis [cm]
       z0 =  -20.000        # minimum position of z-axis [cm]
       z1 =  -20.000        # maximum position of z-axis [cm]
      dir =   1.0000        # z-direction of beam [cosine]

[ M a t e r i a l ]
set:c1[0.101] $ mass fraction of hydrogen
set:c2[0.111] $ mass fraction of carbon
set:c3[0.026] $ mass fraction of nitrogen
set:c4[0.762] $ mass fraction of oxygen
set:c5[10.0*1.0e-6] $ mass fraction of 10B, 1 ppm = 1.0e-6

set:c8[6.022e23/1.0e24]   $ Avogadro number / 1.0e24
set:c9[1.602e-10]         $ Conversion coefficient from MeV/g to Gy

set:c11[c1/1.00784*c8]    $ atomic density of hydrogen (10^24 atom/g)
set:c12[c2/12.0107*c8]    $ atomic density of carbon (10^24 atom/g)
set:c13[c3/14.0067*c8]    $ atomic density of nitrogen (10^24 atom/g)
set:c14[c4/15.9990*c8]    $ atomic density of oxygen (10^24 atom/g)
set:c15[c5/10.0129*c8]    $ atomic density of 10B (10^24 atom/g)
set:c10[c11+c12+c13+c14+c15]   $ atomic density of material 1

m1    $ ICRU soft issue with 10B
            H         -c1
            C         -c2
            N         -c3
            O         -c4
          10B         -c5
mt1   lwtr.20t

Mat[2001]     H  1.0  $ H
Mat[2002]     N  1.0  $ N
Mat[2003]   10B  1.0  $ 10B

[ C e l l ]
 1          1  -1.0   1 -2 -10  $ Target
98          0         #1 -999  $ Void
99         -1             999  $ Outer region

[ S u r f a c e ]
 1            pz     0.0
 2            pz    10.0
 10           cz    10.0
 999          so   100.0

[t-track]
   mesh = r-z
   r-type =    2            # r-mesh is linear given by rmin, rmax and nr
     rmin =   0.000000      # minimum value of r-mesh points
     rmax =  10.000000      # maximum value of r-mesh points
       nr =    1            # number of r-mesh points
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =    0.00000      # minimum value of z-mesh points
     zmax =   10.00000      # maximum value of z-mesh points
       nz =   10            # number of z-mesh points
     axis =   z            # axis of output
     file = photon.out       # file name of output for the above axis
     part = photon
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
             0.0  1000.0
     unit =    1            # unit is [1/cm^2/source]
multiplier = all $ The following is subsection of multiplier.
     part  = photon
     emax  = 2.000e+01
      mat        mset1
      all (c10*c9  1 -5 -6)
    y-txt = Dose [Gy/source]
   epsout = 1
    angel = ymin(1.0e-17) ymax(1.0e-14)

[t-track]
   mesh = r-z
   r-type =    2            # r-mesh is linear given by rmin, rmax and nr
     rmin =   0.000000      # minimum value of r-mesh points
     rmax =  10.000000      # maximum value of r-mesh points
       nr =    1            # number of r-mesh points
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =    0.00000      # minimum value of z-mesh points
     zmax =   10.00000      # maximum value of z-mesh points
       nz =   10            # number of z-mesh points
     axis =   z            # axis of output
     file = hydro.out       # file name of output for the above axis
     part = neutron
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
             0.0  1000.0
     unit =    1            # unit is [1/cm^2/source]
multiplier = all $ The following is subsection of multiplier.
     part  = neutron
     emax  = 2.000e+01
      mat        mset1           
      all (c11*c9 2001 1 -4)
    y-txt = Dose [Gy/source]
   epsout = 1
    angel = ymin(1.0e-17) ymax(1.0e-14)

[t-track]
   mesh = r-z
   r-type =    2            # r-mesh is linear given by rmin, rmax and nr
     rmin =   0.000000      # minimum value of r-mesh points
     rmax =  10.000000      # maximum value of r-mesh points
       nr =    1            # number of r-mesh points
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =    0.00000      # minimum value of z-mesh points
     zmax =   10.00000      # maximum value of z-mesh points
       nz =   10            # number of z-mesh points
     axis =   z            # axis of output
     file = nitro.out       # file name of output for the above axis
     part = neutron
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
             0.0  1000.0
     unit =    1            # unit is [1/cm^2/source]
multiplier = all $ The following is subsection of multiplier.
     part  = neutron
     emax  = 2.000e+01
      mat        mset1
      all (c13*c9 2002 1 -4)
    y-txt = Dose [Gy/source]
   epsout = 1
    angel = ymin(1.0e-17) ymax(1.0e-14)

[t-track]
   mesh = r-z
   r-type =    2            # r-mesh is linear given by rmin, rmax and nr
     rmin =   0.000000      # minimum value of r-mesh points
     rmax =  10.000000      # maximum value of r-mesh points
       nr =    1            # number of r-mesh points
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =    0.00000      # minimum value of z-mesh points
     zmax =   10.00000      # maximum value of z-mesh points
       nz =   10            # number of z-mesh points
     axis =   z            # axis of output
     file = boron.out       # file name of output for the above axis
     part = neutron
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
             0.0  1000.0
     unit =    1            # unit is [1/cm^2/source]
multiplier = all $ The following is subsection of multiplier.
     part  = neutron
     emax  = 2.000e+01
      mat        mset1
      all (c15*c9 2003 1 -4)
    y-txt = Dose [Gy/source]
    angel = ymin(1.0e-17) ymax(1.0e-14)
   epsout = 1

[t-deposit]
   mesh = r-z
   r-type =    2            # r-mesh is linear given by rmin, rmax and nr
     rmin =   0.000000      # minimum value of r-mesh points
     rmax =  10.000000      # maximum value of r-mesh points
       nr =    1            # number of r-mesh points
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =    0.00000      # minimum value of z-mesh points
     zmax =   10.00000      # maximum value of z-mesh points
       nz =   10            # number of z-mesh points
     axis =   z            # axis of output
     file = dose.out       # file name of output for the above axis
     part = (neutron photon)
     unit =    0            # unit is [Gy/source]
   output = dose
   epsout = 1
    angel = ymin(1.0e-17) ymax(1.0e-14)

[anatally]  $ for RBE-CBE weighted dose
$ parameters used in anatally (icntl=17) (same as default value)
 set: c99[0.0]    $ Weighted sum (=0) FFT SMK (=1), Taylor-expansion SMK (=2), z*-based MK (=3)
 set: c90[1.0]    $ dose scaling factor, normalized at 10 Gy at the entrance position
 set: c1[1.0*c90]   $ RBE for photon dose
 set: c2[2.5*c90]   $ RBE for hydrogen dose
 set: c3[2.5*c90]   $ RBE for nitrogen dose
 set: c4[3.8*c90]   $ CBE for boron dose
anatally start    1
manatally = 0
sfile=RBEdose.out
nfile =       4
photon.out
hydro.out
nitro.out
boron.out
anatally end    1


[END]

