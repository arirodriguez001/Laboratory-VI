[ T - T r a c k ]
    title = Track in xyz mesh
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin =  -30.00000      # minimum value of x-mesh points
     xmax =   30.00000      # maximum value of x-mesh points
#    xdel =   1.000000      # mesh width of x-mesh points
       nx =   60            # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
#          -3.00000E+01 -2.90000E+01 -2.80000E+01 -2.70000E+01 -2.60000E+01
#          -2.50000E+01 -2.40000E+01 -2.30000E+01 -2.20000E+01 -2.10000E+01
#          -2.00000E+01 -1.90000E+01 -1.80000E+01 -1.70000E+01 -1.60000E+01
#          -1.50000E+01 -1.40000E+01 -1.30000E+01 -1.20000E+01 -1.10000E+01
#          -1.00000E+01 -9.00000E+00 -8.00000E+00 -7.00000E+00 -6.00000E+00
#          -5.00000E+00 -4.00000E+00 -3.00000E+00 -2.00000E+00 -1.00000E+00
#           0.00000E+00  1.00000E+00  2.00000E+00  3.00000E+00  4.00000E+00
#           5.00000E+00  6.00000E+00  7.00000E+00  8.00000E+00  9.00000E+00
