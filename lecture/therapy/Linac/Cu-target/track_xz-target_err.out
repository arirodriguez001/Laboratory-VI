#newpage:
#   no. =  1   ie  =  1   iy  =  1   part. = electron
#   e = (   0.0000E+00  -   1.0000E+03  )
#   y = (  -5.0000E+00  -   5.0000E+00  )

'no. =  1,  ie =  1,  iy =  1'
msuc: {\huge Track in xyz mesh}
msdl: {\it plotted by \ANGEL \version}
msdr: {\it calculated by \PHITS  2.77}

x: z [cm]
y: x [cm]
set: c1[ 1.000] c2[ 0.900] c5[ 0.800] c6[ 1.000] c7[ 0.000] c8[ 0.000]
p: form[c1] xfac[c2] afac[c5] scal[c6] xorg[c7] yorg[c8] nosp
set: c3[1.0e-4] c4[1.0]
p: cmin[c3] cmax[c4]
p: dmin(1e-31)
p: zlog
p: xmin( -120.0000    ) xmax( -110.0000    )
p: ymin( -5.000000    ) ymax(  5.000000    )
