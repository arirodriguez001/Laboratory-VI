#           2.00000E+01
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
#    data = ( e(i), i = 1, ne + 1 )
            0.00000E+00  1.00000E+03
     unit =    1            # unit is [1/cm^2/source]
 material =  all            # (D=all) number of specific material
  2D-type =    3            # 1:Cont, 2:Clust, 3:Color, 4:xyz, 5:mat, 6:Clust+Cont, 7:Col+Cont
     axis =   xz            # axis of output
     file = track_xz.out    # file name of output for the above axis
     part =  electron   photon     neutron  
# kf/name :  11         22         2112     
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
    resol =    1            # (D=1) resolution of gshow or rshow
    width = 0.5000000       # (D=0.5) width of lines for gshow or rshow
   epsout =    1            # (D=0) generate eps file by ANGEL
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :         218 (  0)           0 (  0)         218 (  0)

#------------------------------------------------------------------------------
#newpage:
#   no. =  1   ie  =  1   iy  =  1   part. = electron
#   e = (   0.0000E+00  -   1.0000E+03  )
#   y = (  -5.0000E+00  -   5.0000E+00  )

'no. =  1,  ie =  1,  iy =  1'
msuc: {\huge Track in xyz mesh}
msdl: {\it plotted by \ANGEL \version}
msdr: {\it calculated by \PHITS  2.77}

x: z [cm]
y: x [cm]
set: c1[ 0.400] c2[ 1.423] c5[ 0.800] c6[ 0.726] c7[ 0.000] c8[ 0.600]
p: form[c1] xfac[c2] afac[c5] scal[c6] xorg[c7] yorg[c8] nosp
set: c3[   4.148213E-13] c4[   1.379521E-01]
p: cmin[c3] cmax[c4]
p: dmin(1e-31)
p: zlog
p: xmin( -130.0000    ) xmax(  20.00000    )
p: ymin( -30.00000    ) ymax(  30.00000    )
