[ T-3Dshow ]
    title = Check onion structure using [T-3dshow] tally
     file = 3dshow.out      # file name of output
 material =   -1            # (D=all) show(+) or transparent(-) material
                6
       x0 =  0.000000       # (D=0.0) x-coordinate of the origin
       y0 =  0.000000       # (D=0.0) y-coordinate of the origin
       z0 =  0.000000       # (D=0.0) z-coordinate of the origin
    e-the =  70.00000       # (D=80.0) eye point theta(degree) from z-axis
    e-phi =  20.00000       # (D=140.0) eye point phi(degree) from x-axis
    e-dst =  80.00000       # (D=w-dst*10) eye point distance from origin
    l-the =  20.00000       # (D=e-the) light point theta from z-axis
    l-phi =  0.000000       # (D=e-phi) light point phi from x-axis
    l-dst =  100.0000       # (D=e-dst) light point distance from origin
    w-wdt =  50.00000       # (D=100) width of window (cm)
    w-hgt =  50.00000       # (D=100) hight of window (cm)
    w-dst =  25.00000       # (D=200) window distance from origin
    w-mnw =  100            # (D=100) mesh number of window width
    w-mnh =  100            # (D=100) mesh number of window hight
   heaven =   z             # (D=y) direction to heaven
    w-ang =  0.000000       # (D=0.0) angle of frame (degree)
   bright = 0.8000000       # (D=0.8) top brightness
     dark = 0.2000000       # (D=0.2) bottom darkness
  axishow =    1            # (D=1) =1: small axis is shown, =2: large, =0: no
      box =    1            # (D=0) number of boxes
      box     0.0000000E+00  0.0000000E+00  0.0000000E+00
              1.0000000E+02  0.0000000E+00  0.0000000E+00
              0.0000000E+00  1.0000000E+02  0.0000000E+00  1.0000000E+02
    resol =    1            # (D=1) resolution of 3dshow
    width = 0.5000000       # (D=0.5) width of lines for 3dshow
    r-out =  50000.00       # (D=50000) radius of outer sphere
   output =    3            # (D=3) 0:draft, 1:line, 2:col, 3:line+col
     line =    1            # (D=0) 0:surface+mat, 1:+region
   shadow =    2            # (D=0) 0:no, 1:shadow
   epsout =    1            # (D=0) generate eps file by ANGEL
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :           1 (  0)       45905 (  0)       45906 (  0)

#------------------------------------------------------------------------------
msuc: {Check onion structure using [T-3dshow] tally}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.35}

p: noxt noyt itic(-1)
set: c1[ 1.000] c2[ 1.200] c5[ 0.500] c6[ 1.000] c7[ 0.000] c8[-0.100]
p: h2fs form[c1] xfac[c2] afac[c5] scal[c6] xorg[c7] yorg[c8] nosp
p: legs[c5*1.3]
p: xmin(  0.000000    ) xmax(  50.00000    )
p: ymin(  0.000000    ) ymax(  50.00000    )

#----- Axis Arrow Here ------ 
# x-position
set: c1[  5.000000    ]
# y-position
set: c2[  5.000000    ]
# size of arrows
set: c3[  1.000000    ]
# size of character
set: c4[  1.000000    ]
a: x[c1] y[c2] ax[c1+( -1.299014    )*c3] ay[c2+( -1.220674    )*c3] c(g)
w:x/ x[c1+( -1.299014    )*c3+(-0.5465546    )*c4] y[c2+( -1.220674    )*c3+(-0.5135933    )*c4] ix(2) iy(2) s[c4] c(e)
a: x[c1] y[c2] ax[c1+(  3.307967    )*c3] ay[c2+(-0.4117928    )*c3] c(b)
w:y/ x[c1+(  3.307967    )*c3+( 0.7442555    )*c4] y[c2+(-0.4117928    )*c3+(-9.2648755E-02)*c4] ix(2) iy(2) s[c4] c(e)
a: x[c1] y[c2] ax[c1+(-4.7860245E-16)*c3] ay[c2+(  3.316877    )*c3] c(r)
w:z/ x[c1+(-4.7860245E-16)*c3+(-1.0821981E-16)*c4] y[c2+(  3.316877    )*c3+( 0.7500000    )*c4] ix(2) iy(2) s[c4] c(e)
#----- End of Axis Arrow ------ 

h: x ny1,0  y2=[y1](C2H4),ic[gray]
 -1.000000E+00 -1.000000E+00

hb: noline clip z  
