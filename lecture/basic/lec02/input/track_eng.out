     axis =     eng            # axis of output
     file = track_eng.out   # file name of output for the above axis
     part =  12C        proton     neutron  
# kf/name :  6000012    2212       2112     
    gshow =    3            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat 5:bmp style
