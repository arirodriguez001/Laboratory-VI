[ T i t l e ]
example 006        -Bragg Peak- sample input

[ P a r a m e t e r s ]
 icntl    = 0
 nwsors   = 1
 maxcas   =  50
 maxbch   = 1 
 esmin    = 1.0e-6
 emin(1)  = 1.0e-3     $ energy cut-off for proton
 emin(2)  = 1          $ energy cut-off for neutron
 emin(15) = 1.0e-6     # (D=1.d9) cut-off energy of deuteron (MeV)
 emin(16) = 1.0e-6     # (D=1.d9) cut-off energy of triton (MeV)
 emin(17) = 1.0e-6     # (D=1.d9) cut-off energy of 3He (MeV)
 emin(18) = 1.0e-6     # (D=1.d9) cut-off energy of Alpha (MeV)
 emin(19) = 1.0e-6     # (D=1.d9) cut-off energy of Heavy Ion (MeV/u)

 nedisp   = 1
 nspred   = 2
 itstep   = 1
 itall    = 1
 file(6)  = phits.out

[ S o u r c e ]
s-type    = 1
proj      = 12C
dir       = 1
x0        = 0
y0        = 0
r0        = 0.0
z0        = -10. 
z1        = -10.
e0        = 290

[ M a t e r i a l ]
mat[1]    1H 2  16O 1

[ S u r f a c e ]
c  == Z-axis ==
5020  pz     -20.
6000  pz       0.
set: c10[10.0]           $ c10 from 0. to 49.
6001  pz     c10
6002  pz     c10+1.      $ width 1. cm
6050  pz      50.
6060  pz      60.
c  == cylinder ==
8001  cz       1.5
8010  cz      10.
8040  cz      40.

[ C e l l ]
  10     1 -1.       6001 -6002       -8001
 100     1 -1.       6000 -6050       -8010
                   #(6001 -6002       -8001)
 200     0           5020 -6060       -8040
                   #(6000 -6050       -8010)
 999    -1          -5020 : 6060 : 8040

[ M a t  N a m e  C o l o r ]
    mat   name      color
     1    Water     pastelcyan

[ T - T R A C K ] 
   mesh =  xyz
 x-type =    1
     nx =    1
            -5.0  5.0
 y-type =    2
     ny =  240
   ymin =  -12.
   ymax =   12.
 z-type =    2
     nz =  250
   zmin =   -5.
   zmax =   20.
   part =   12C proton neutron
 e-type =    1
     ne =    1
             0.0  5000.0
   unit =    1  
   axis =   yz  
   file =  yz-show_part.dat
  angel = cmin(1.e-06) cmax(7.e-02)
  gshow =    1
 epsout =    1

[ E n d ]


