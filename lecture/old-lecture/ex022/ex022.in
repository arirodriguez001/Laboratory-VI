
[ P a r a m e t e r s ]
 icntl   = 5     
 maxcas  = 100000
 maxbch  = 1     
 emin(2) = 1.e-8

 file(6) = phits2.out

[ S o u r c e ] 
 totfact = 3
<source> = 9.72
  s-type = 4    
    proj = proton
      z0 = 2
      z1 = 29
      r0 = 5
      r1 = 4
     dir = 0.0
  e-type = 6
     eg1 = 1.e-6
     eg2 = 1.e-3
     nm  = -200
     set: c10[1.e-4]
    f(x) = x**(1.5)*exp(-x/c10)
<source> = 1
  s-type = 4    
    proj = photon
      z0 = 1
      z1 = 2
      r0 = 5
     dir = -1
  e-type = 5
     eg1 = 1.e-3
     eg2 = 5.e-1
     nm  = 200
     set: c10[1.e-1]
     set: c20[1.e-1/2.35482]
    f(x) = exp(-(x-c10)**2/2/c20**2)
<source> = 1
  s-type = 4    
    proj = neutron
      z0 = 29
      z1 = 30
      r0 = 5
  e-type = 6
     eg1 = 1.e-2
     eg2 = 1.e+3
     nm  = -200
     set: c10[92.469]
     set: c20[5.644e+10]
    f(x) = c10/c20*exp(-sqrt(x*(x+1876))/c10)*(x+938)/sqrt(x*(x+1876))
     dir = data
  a-type = 5
     ag1 = 0
     ag2 = 1
     nn  = 200
    g(x) = exp(-(x-1)**2/0.3**2)

[ M a t e r i a l ]

MAT[ 1 ]
  Cu    -8.96
MAT[ 2 ]
  63Cu   -6.19

[surface]  
  1   cz 1000
  2   pz -10
  3   pz  50

[cell] off
  1   1   -8.96   4 -5 -1
  2   2   -6.19       3 -6 -2 #1
  5  -1           -3 : 6 : 2

[cell] 
  1   0   2 -3 -1
  5  -1   -2 : 3 : 1

[t-product] 
     mesh = r-z
   r-type =  2
       nr =  1
     rmin =  0
     rmax =  500
   z-type =  2
       nz =  1
     zmin =  0
     zmax =  50
   e-type = 3
    ne    = 200
    emin  = 1.e-6
    emax  = 1000
    unit  = 1
    axis  = eng
    file  = source1.dat
   output = source
     part = proton photon neutron
   epsout = 1
   angel = ymin(1.e-6)

[t-product] 
     mesh = xyz
   x-type =  2
       nx =  50
     xmin =  -7
     xmax =   7
   y-type =  2
       ny =  1
     ymin =  -0.1
     ymax =   0.1
   z-type =  2
       nz =  74
     zmin =   -2
     zmax =   35
   e-type = 2
    ne    = 1
    emin  = 1.e-6
    emax  = 3000
     unit = 2
     axis = xz
     file = source2.dat
   output = source
   epsout = 1

[t-product] 
     mesh = xyz
   x-type =  2
       nx =  100
     xmin =  -7
     xmax =   7
   y-type =  2
       ny =  100
     ymin =  -7
     ymax =   7
   z-type =  2
       nz =  1
     zmin =  1
     zmax =  2
   e-type = 2
    ne    = 1
    emin  = 1.e-6
    emax  = 3000
     unit = 2
     axis = xy
     file = source3.dat
   output = source
   epsout = 1

[t-product] 
     mesh = xyz
   x-type =  2
       nx =  100
     xmin =  -7
     xmax =   7
   y-type =  2
       ny =  100
     ymin =  -7
     ymax =   7
   z-type =  2
       nz =  1
     zmin =  14
     zmax =  15
   e-type = 2
    ne    = 1
    emin  = 1.e-6
    emax  = 3000
     unit = 2
     axis = xy
     file = source4.dat
   output = source
   epsout = 1

[t-product] 
     mesh = r-z
   r-type =  2
       nr =  1
     rmin =  0
     rmax =  500
   z-type =  2
       nz =  1
     zmin =  0
     zmax =  50
   e-type = 3
    ne    = 1
    emin  = 1.e-6
    emax  = 1000
   a-type =  2
       na =  100
     amin =   0
     amax =   1
    unit  = 21
    axis  = cos
    file  = source5.dat
   output = source
     part = proton photon neutron
   epsout = 1
   angel = ylin

[END]
