[ T i t l e ]
3um Si test case

[ P a r a m e t e r s ]

 e-mode = 1

 itall = 1
 icntl = 0

 maxcas  = 10000000
 maxbch  = 10

 emin(1) = 1.e-6
 emin(2) = 0.0
 dmax(2) = 20.0
 emin(12) = 1.0e-3
 emin(13) = 1.0e-3
 emin(14) = 1.0e-3
 dmax(12) = 1000.0
 dmax(13) = 1000.0
 dmax(14) = 1000.0

C emin(15) = 1.0e-6
C emin(16) = 1.0e-6
C emin(17) = 1.0e-6
C emin(18) = 1.0e-6
C emin(19) = 1.0e-6

  delt0 = 1.022e-4

 file(6) = phits.out
 file(7) = c:/phits/data/xsdir.jnd
 file(14) = c:/phits/data/trxcrd.dat 

[ S o u r c e ]
   s-type =   1      
     proj =  neutron 
       e0 =   19.    
       r0 =   0.010 
       x0 =       0. 
       y0 =       0. 
       z0 =  -0.00100 
       z1 =  -0.00100 
      dir =   1.0000 

[ Material ]
$ Si  2.329 g/cm^3
M1       14028.50c  1.0

[ Cell ]
  1  0         1 -2  11 -12  13 -14
  2  1 -2.329  2 -3  11 -12  13 -14
  3  0         3 -4  11 -12  13 -14
 10 -1         #(1 -4  11  -12  13  -14)

[ Surface ]
1  pz -1.0e-2 $ End of vaccum
2  pz  0.00   $ upper surface
3  pz  3.0e-4 $ End of Si
4  pz  1.00
11 px  -0.05
12 px   0.05
13 py  -0.05
14 py   0.05


[ T-Heat ]
mesh = reg
   reg = 2
axis = eng
e-type = 3
ne = 100
emin = 1e-5
emax = 1e2
output = deposit-heat
electron = 1
deposit = 0
unit = 3
file = heat-01.dat
epsout = 1

[ T-Deposit ]
mesh = reg
   reg = 2
axis = eng
e-type = 3
ne = 100
emin = 1e-5
emax = 1e2
output = deposit
unit = 3
file = dep-01.dat
epsout = 1
part = all deuteron triton alpha

[END]
