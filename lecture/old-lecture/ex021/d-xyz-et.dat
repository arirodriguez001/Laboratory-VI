[ T - Deposit ]
    title = [t-deposit] in xyz mesh
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    1            # x-mesh is given by the below data
       nx =    1            # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
           -2.00000E+01  2.00000E+01
   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin =  -20.00000      # minimum value of y-mesh points
     ymax =   20.00000      # maximum value of y-mesh points
#    ydel =   40.00000      # mesh width of y-mesh points
       ny =    1            # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
#          -2.00000E+01  2.00000E+01
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =   0.000000      # minimum value of z-mesh points
     zmax =   60.00000      # maximum value of z-mesh points
#    zdel =   60.00000      # mesh width of z-mesh points
       nz =    1            # number of z-mesh points
#    data = ( z(i), i = 1, nz + 1 )
#           0.00000E+00  6.00000E+01
     unit =    3            # unit is [1/source] : only for output=deposit
   letmat =    5            # (D=0) material id for LET, 0: real material
  dedxfnc =    2            # (D=0) user defined multiplier, 0(no), 1, 2
 material =  all            # (D=all) number of specific material
   output = deposit         # deposit enerygy distribution
   e-type =    2            # e-mesh is linear given by emin, emax and ne
     emin =   0.000000      # minimum value of e-mesh points
     emax =   200.0000      # maximum value of e-mesh points
#    edel =   4.000000      # mesh width of e-mesh points
       ne =   50            # number of e-mesh points
#    data = ( e(i), i = 1, ne + 1 )
#           0.00000E+00  4.00000E+00  8.00000E+00  1.20000E+01  1.60000E+01
#           2.00000E+01  2.40000E+01  2.80000E+01  3.20000E+01  3.60000E+01
#           4.00000E+01  4.40000E+01  4.80000E+01  5.20000E+01  5.60000E+01
#           6.00000E+01  6.40000E+01  6.80000E+01  7.20000E+01  7.60000E+01
#           8.00000E+01  8.40000E+01  8.80000E+01  9.20000E+01  9.60000E+01
#           1.00000E+02  1.04000E+02  1.08000E+02  1.12000E+02  1.16000E+02
#           1.20000E+02  1.24000E+02  1.28000E+02  1.32000E+02  1.36000E+02
#           1.40000E+02  1.44000E+02  1.48000E+02  1.52000E+02  1.56000E+02
#           1.60000E+02  1.64000E+02  1.68000E+02  1.72000E+02  1.76000E+02
#           1.80000E+02  1.84000E+02  1.88000E+02  1.92000E+02  1.96000E+02
#           2.00000E+02
   t-type =    2            # t-mesh is linear given by tmin, tmax and nt
     tmin =   0.000000      # minimum value of t-mesh points
     tmax =   5.000000      # maximum value of t-mesh points
#    tdel =  0.1000000      # mesh width of t-mesh points
       nt =   50            # number of t-mesh points
#    data = ( t(i), i = 1, nt + 1 )
#           0.00000E+00  1.00000E-01  2.00000E-01  3.00000E-01  4.00000E-01
#           5.00000E-01  6.00000E-01  7.00000E-01  8.00000E-01  9.00000E-01
#           1.00000E+00  1.10000E+00  1.20000E+00  1.30000E+00  1.40000E+00
#           1.50000E+00  1.60000E+00  1.70000E+00  1.80000E+00  1.90000E+00
#           2.00000E+00  2.10000E+00  2.20000E+00  2.30000E+00  2.40000E+00
#           2.50000E+00  2.60000E+00  2.70000E+00  2.80000E+00  2.90000E+00
#           3.00000E+00  3.10000E+00  3.20000E+00  3.30000E+00  3.40000E+00
#           3.50000E+00  3.60000E+00  3.70000E+00  3.80000E+00  3.90000E+00
#           4.00000E+00  4.10000E+00  4.20000E+00  4.30000E+00  4.40000E+00
#           4.50000E+00  4.60000E+00  4.70000E+00  4.80000E+00  4.90000E+00
#           5.00000E+00
     axis = eng-t           # axis of output
     file = d-xyz-et.dat    # file name of output for the above axis
     part =  all      
# kf/name :  0        
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
    resol =    1            # (D=1) resolution of gshow or rshow
    width = 0.5000000       # (D=0.5) width of lines for gshow or rshow
   epsout =    1            # (D=0) generate eps file by ANGEL
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :        5208 (  0)        7751 (  0)       12959 (  0)

#------------------------------------------------------------------------------
#newpage:
#   no. =  1   ix  =  1   iy  =  1   iz  =  1   part. = all     
#   x = (  -2.0000E+01  -   2.0000E+01  )
#   y = (  -2.0000E+01  -   2.0000E+01  )
#   z = (   0.0000E+00  -   6.0000E+01  )

'no. =  1,  ix =  1,  iy =  1,  iz =  1'
msuc: {\huge [t-deposit] in xyz mesh}
msdl: {\it plotted by \ANGEL \version}
msdr: {\it calculated by \PHITS  2.30}

x: Deposit Energy of XYZ mesh [MeV]

y: Time [nsec]
set: c1[ 0.750] c2[ 1.039] c5[ 0.800] c6[ 0.904] c7[ 0.000] c8[ 0.133]
p: form[c1] xfac[c2] afac[c5] scal[c6] xorg[c7] yorg[c8] nosp
set: c3[   1.000000E-03] c4[   5.500000E-02]
p: cmin[c3] cmax[c4]
p: dmin(1e-31)
p: zlog
p: xmin(  0.000000    ) xmax(  200.0000    )
p: ymin(  0.000000    ) ymax(  5.000000    )
#  ny =  50   nx =  50
# ( ( data(x,y), x = 1, nx ), y = ny, 1, -1 )

hc:  y =   4.950000     to  5.0000000E-02 by  0.1000000     ; x =   2.000000     to   198.0000     by   4.000000     ;
