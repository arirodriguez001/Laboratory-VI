       mesh = xyz
   x-type = 2
       nx = 200
     xmin = -400.
     xmax =  800.
   y-type = 2
       ny = 1
     ymin = -200.
     ymax =  200.
   z-type = 2
       nz = 200
     zmin = -300.
     zmax = 2000.
     axis = xz
