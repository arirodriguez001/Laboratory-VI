
[ P a r a m e t e r s ]
 icntl   = 0
 itall   = 1
 maxcas  = 100
 maxbch  = 1
 file(6) = phits.out
 imagnf  = 1
 itstep  = 1


set: c1[1]   $ beam width
set: c2[100] $ duct width
set: c3[400] $ outer width

set: c4[500]  $ length of the first straight part
set: c5[400]  $ length of the curved part
set: c6[1000] $ length of the second straight part
set: c7[30]   $ angle of the curved part (degree)
set: c8[c5/(c7/180*pi)] $ radius of curved part

set: c13[300] $ start point of the first Q4 in the second part
set: c14[500] $ start point of the first Q4 in the second part
set: c15[600] $ start point of the second Q4 in the second part
set: c16[800] $ start point of the second Q4 in the second part

[ T r a n s f o r m ]

set: c10[0]   $ angle of around Z (degree)
set: c20[c7]  $ angle of around Y (degree)
set: c30[0]   $ angle of around X (degree)

set: c40[c8]  $ radius of curved part
set: c41[c40*sin(c20/180*pi)]    $ z displacement
set: c42[c40-c40*cos(c20/180*pi)] $ x displacement

tr1   c42 0 c41+c4
      cos(c10/180*pi)*cos(c20/180*pi)
      sin(c10/180*pi)*cos(c30/180*pi)+cos(c10/180*pi)*sin(c20/180*pi)*sin(c30/180*pi)
      sin(c10/180*pi)*sin(c30/180*pi)-cos(c10/180*pi)*sin(c20/180*pi)*cos(c30/180*pi)
     -sin(c10/180*pi)*cos(c20/180*pi)
      cos(c10/180*pi)*cos(c30/180*pi)-sin(c10/180*pi)*sin(c20/180*pi)*sin(c30/180*pi)
      cos(c10/180*pi)*sin(c30/180*pi)+sin(c10/180*pi)*sin(c20/180*pi)*cos(c30/180*pi)
      sin(c20/180*pi)
     -cos(c20/180*pi)*sin(c30/180*pi)
      cos(c20/180*pi)*cos(c30/180*pi)
      1

set: c10[90]   $ angle of around Z (degree)
tr2   c42 0 c41+c4
      cos(c10/180*pi)*cos(c20/180*pi)
      sin(c10/180*pi)*cos(c30/180*pi)+cos(c10/180*pi)*sin(c20/180*pi)*sin(c30/180*pi)
      sin(c10/180*pi)*sin(c30/180*pi)-cos(c10/180*pi)*sin(c20/180*pi)*cos(c30/180*pi)
     -sin(c10/180*pi)*cos(c20/180*pi)
      cos(c10/180*pi)*cos(c30/180*pi)-sin(c10/180*pi)*sin(c20/180*pi)*sin(c30/180*pi)
      cos(c10/180*pi)*sin(c30/180*pi)+sin(c10/180*pi)*sin(c20/180*pi)*cos(c30/180*pi)
      sin(c20/180*pi)
     -cos(c20/180*pi)*sin(c30/180*pi)
      cos(c20/180*pi)*cos(c30/180*pi)
      1

set: c10[90]   $ angle of around Z (degree)
set: c20[0]    $ angle of around Y (degree)
set: c30[0]    $ angle of around X (degree)

tr3   0 0 0
      cos(c10/180*pi)*cos(c20/180*pi)
      sin(c10/180*pi)*cos(c30/180*pi)+cos(c10/180*pi)*sin(c20/180*pi)*sin(c30/180*pi)
      sin(c10/180*pi)*sin(c30/180*pi)-cos(c10/180*pi)*sin(c20/180*pi)*cos(c30/180*pi)
     -sin(c10/180*pi)*cos(c20/180*pi)
      cos(c10/180*pi)*cos(c30/180*pi)-sin(c10/180*pi)*sin(c20/180*pi)*sin(c30/180*pi)
      cos(c10/180*pi)*sin(c30/180*pi)+sin(c10/180*pi)*sin(c20/180*pi)*cos(c30/180*pi)
      sin(c20/180*pi)
     -cos(c20/180*pi)*sin(c30/180*pi)
      cos(c20/180*pi)*cos(c30/180*pi)
      1

[ S o u r c e ]
 s-type = 2
 proj   =  proton
 e0     =  160
 x0     = -c1/2
 x1     =  c1/2
 y0     = -c1/2
 y1     =  c1/2
 z0     =  0.0
 z1     =  0.0
 dir    =  1.0
 dom    =  2.0
 phi    =  0.0

[ M a t e r i a l ] 
m1   26056   1

[ S u r f a c e ]  

100     pz  0
101     pz  c4
102  1  pz  0

103  1  pz  c13
104  1  pz  c14
105  1  pz  c15
106  1  pz  c16

110  1  pz  c6

200     px  -c2/2
201     px   c2/2
202     py  -c2/2
203     py   c2/2
204     px  -c3/2
205     px   c3/2
206     py  -c3/2
207     py   c3/2

210  1  px  -c2/2
211  1  px   c2/2
214  1  px  -c3/2
215  1  px   c3/2

220     c/y  c8  c4  c8-c2/2
221     c/y  c8  c4  c8+c2/2
224     c/y  c8  c4  c8-c3/2
225     c/y  c8  c4  c8+c3/2

[ C e l l ] 

100  0        100 -101 200 -201 202 -203
101  1 -7.8   100 -101 204 -205 206 -207 ( -200 : 201 : -202 : 203 )

200  0        101 -102 220 -221 202 -203
201  1 -7.8   101 -102 224 -225 206 -207 ( -220 : 221 : -202 : 203 )

300  0        102 -103 210 -211 202 -203
301  0        103 -104 210 -211 202 -203
302  0        104 -105 210 -211 202 -203
303  0        105 -106 210 -211 202 -203
304  0        106 -110 210 -211 202 -203
310  1 -7.8   102 -110 214 -215 206 -207 ( -210 : 211 : -202 : 203 )

900 -1        100 -101 ( -204 : 205 : -206 : 207 )
901 -1        101 -102 ( -224 : 225 : -206 : 207 )
903 -1        102 -110 ( -214 : 215 : -206 : 207 )
904 -1        -100 : 110

[ Magnetic Field ] 
     reg       typ      gap         mgf          trcl
     200         2      30.0       -2.5          0
     301         4      30.0        1.0          1
     303         4      40.0        2.0          2

[ T - Track ]
       mesh = xyz
   x-type = 2
       nx = 200
     xmin = -400.
     xmax =  800.
   y-type = 2
       ny = 1
     ymin = -200.
     ymax =  200.
   z-type = 2
       nz = 200
     zmin = -300.
     zmax = 2000.
   e-type = 2
       ne = 1
     emin = 0.
     emax = 100000.
     axis = xz
     unit = 1
     file = t-xz00.dat
   epsout = 1
    gshow = 1

