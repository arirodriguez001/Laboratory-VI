   8.0000E+00   9.0000E+00   7.3281E+00  0.0904
   9.0000E+00   1.0000E+01   7.1784E+00  0.0761
   1.0000E+01   1.1000E+01   7.6549E+00  0.0918
   1.1000E+01   1.2000E+01   8.0017E+00  0.1055
   1.2000E+01   1.3000E+01   8.5953E+00  0.1103
   1.3000E+01   1.4000E+01   9.8292E+00  0.1063
   1.4000E+01   1.5000E+01   1.2098E+01  0.1113
   1.5000E+01   1.6000E+01   2.0087E+01  0.1154
   1.6000E+01   1.7000E+01   5.8359E+00  0.1198
   1.7000E+01   1.8000E+01   1.2432E+00  0.2040
   1.8000E+01   1.9000E+01   1.3417E+00  0.2588
   1.9000E+01   2.0000E+01   1.0127E+00  0.3563

