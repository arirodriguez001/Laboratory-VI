#           2.51189E+04  3.31131E+04  4.36516E+04  5.75440E+04  7.58578E+04
#           1.00000E+05
     unit =    2            # unit is [MeV/(keV/um)/source]
   letmat =    5            # (D=0) material id for LET, 0: real material
 material =  all            # (D=all) number of specific material
     axis =  let            # axis of output
     file = let-arzp.dat    # file name of output for the above axis
     part =  proton     nucleus    electron   alpha      pion+      muon+    
# kf/name :  2212       0          11         2000004    211        -13      
