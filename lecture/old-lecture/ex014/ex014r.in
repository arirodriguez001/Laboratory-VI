[ T i t l e ]
EXAMPLE014          Norihiro MATSUDA    02 JULY 2010

[ P a r a m e t e r s ]  
 icntl    =      0
 maxcas   =   1000
 maxbch   =      1
 emin(2)  =      1.0e-10
 dmax(2)  =     20.0
 itall    =      1
 icput    =      1
 iggcm    =      1
 file(6)  =   phits.out_ex014r
 file(7)  = c:/phits/data/xsdir.jnd
 file(14) = c:/phits/data/trxcrd.dat
 e-mode   =      1  

[ S o u r c e ]
   s-type =   1
     proj =   proton
       e0 =   1.e+03
       z0 = -99.99
       z1 = -99.99
       r0 =   0.0
     dir  =   1.0

[ M a t e r i a l ]
MAT[29]  63Cu     69.17      $ copper
         65Cu     30.83
MAT[1]   14N      78         $ air
         16O      21

[ C e l l ]
  20    29 -8.93     5010 -6010                   -8010  $ Target
 100     1 -0.001205                  -9100
                   #(5010 -6010                   -8010)
 999    -1                       9100                    $ Outer void

[ S u r f a c e ]
c  == Z-axis ==
C target thickness: 20.0 cm
5010  pz     -10.0
6010  pz      10.0
c  == cylinder ==
C target radius: 10.0 cm
8010  cz      10.0
c  == sphere ==
C distance from the target: 100.0 cm
9100  so     100.0

[ M a t  N a m e  C o l o r ]  
    mat   name      color
    29    Target    black  
     1    Air       pastelcyan  

[ T - Y i e l d ]  
   mesh =  r-z
 r-type =    2
     nr =    1
   rmin =    0.0
   rmax =   10.0
 z-type =    2
     nz =    1
   zmin =  -10.0
   zmax =   10.0
   part =  proton
   unit =    1
   axis =  chart
   file =  chart2.dat
   info =    1
 epsout =    1

[END]


