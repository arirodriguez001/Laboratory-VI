[ T i t l e ]
example 009        -Bragg Peak- sample input

[ P a r a m e t e r s ]
 icntl    = 0
 nwsors   = 1
 maxcas   = 200
 maxbch   = 1 
 esmin    = 1.0e-6
 emin(1)  = 1.0e-3     $ energy cut-off for proton
 emin(2)  = 1          $ energy cut-off for neutron
 emin(15) = 1.0e-6     # (D=1.d9) cut-off energy of deuteron (MeV)
 emin(16) = 1.0e-6     # (D=1.d9) cut-off energy of triton (MeV)
 emin(17) = 1.0e-6     # (D=1.d9) cut-off energy of 3He (MeV)
 emin(18) = 1.0e-6     # (D=1.d9) cut-off energy of Alpha (MeV)
 emin(19) = 1.0e-6     # (D=1.d9) cut-off energy of Heavy Ion (MeV/u)

 nedisp   = 1
 nspred   = 2
 itstep   = 1
 itall    = 1
 file(6)  = phits.out

[ S o u r c e ]
s-type    = 1
proj      = 12C
dir       = 1
x0        = 0
y0        = 0
r0        = 2.5
z0        = -10. 
z1        = -10.
e0        = 290

[ M a t e r i a l ]
mat[1]    1H 2  16O 1

[ S u r f a c e ]
c  == Z-axis ==
5020  pz     -20.
6000  pz       0.
set: c10[10.0]           $ c10 from 0. to 49.
6001  pz     c10
6002  pz     c10+1.      $ width 1. cm
6050  pz      50.
6060  pz      60.
c  == cylinder ==
8001  cz       1.5
8010  cz      10.
8040  cz      40.

[ C e l l ]
  10     1 -1.       6001 -6002       -8001
  11     1 -1.       6001 -6002  8001 -8010
 100     1 -1.       6000 -6001       -8010
 101     1 -1.       6002 -6050       -8010
 200     0           5020 -6060       -8040
                   #(6000 -6050       -8010)
 999    -1          -5020 : 6060 : 8040

[ M a t  N a m e  C o l o r ]
    mat   name      color
     1    Water     pastelcyan

[ T - C R O S S ]
   mesh =  reg
    reg =    2
   r-in   r-out    area
    100     10      pi*1.5**2
     10    100      pi*1.5**2
   part =  neutron
   unit =    3
   axis =  reg
   file =  fluence_omni.dat
 output =    o-curr
 epsout =    1

[ T - C R O S S ]
   mesh =  r-z
 r-type =    1
     nr =    1
      0. 1.5
 z-type =    1
     nz =    1
     10. 11.
part =  neutron
   unit =    3
   axis =    z
   file =  fluence_forw.dat
 output =   of-curr

[ T - C R O S S ]
   mesh =  r-z
 r-type =    1
     nr =    1
      0. 1.5
 z-type =    1
     nz =    1
     10. 11.
   part =  neutron
   unit =    3
   axis =    z
   file =  fluence_back.dat
 output =   ob-curr
 epsout =    0

[ E n d ]


