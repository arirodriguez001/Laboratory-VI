[ T - C r o s s ]
    title = [t-cross] in r-z mesh
     mesh =  r-z            # mesh type is r-z scoring mesh
       x0 =   0.000000      # center x-position of r-z mesh
       y0 =   0.000000      # center y-position of r-z mesh
   r-type =    1            # r-mesh is given by the below data
       nr =    1            # number of r-mesh points
#    data = ( r(i), i = 1, nr + 1 )
            0.00000E+00  1.50000E+00
   z-type =    1            # z-mesh is given by the below data
       nz =    1            # number of z-mesh points
#    data = ( z(i), i = 1, nz + 1 )
            1.00000E+01  1.10000E+01
     unit =    1            # unit is [1/cm^2/source]
     axis =    z            # axis of output
     file = fluence_back.dat  # file name of output for the above axis
   output = ob-curr         # surface crossing omni backward current
     part =  neutron  
# kf/name :  2112     
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :          18 (  0)          11 (  0)          29 (  0)

#------------------------------------------------------------------------------
#newpage:
#   no. =  1   ir  =  1
#   r = (   0.0000E+00  -   1.5000E+00  )

x: z [cm]
y: OB-Curr [1/cm^2/source]                 
p: xlin ylog afac(0.8) form(0.9)
h:              x            y(neutron ),hh0l  n  
#       z surface position    ob-curr    r.err 
                1.0000E+01   7.0736E-04  0.9975
                1.1000E+01   7.0736E-04  0.9975

#   sum over    1.4137E+01   7.0736E-04  0.7053

'no. =  1,   ir =  1'
msuc: {\huge [t-cross] in r-z mesh}
msdl: {\it plotted by \ANGEL \version}
msdr: {\it calculated by \PHITS  2.30}
wt: s(0.7)
\vspace{-3}
  z surface crossing
  area  &=&   7.0686E+00 [cm^2]
  rmin  &=&   0.0000E+00 [cm]
  rmax  &=&   1.5000E+00 [cm]
e:

