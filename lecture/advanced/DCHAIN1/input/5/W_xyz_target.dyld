[ T-Yield ]
    title = W target (xyz)
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin =  -4.000000      # minimum value of x-mesh points
     xmax =   4.000000      # maximum value of x-mesh points
#    xdel =   1.000000      # mesh width of x-mesh points
       nx =      8          # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
#          -4.00000E+00 -3.00000E+00 -2.00000E+00 -1.00000E+00  0.00000E+00
#           1.00000E+00  2.00000E+00  3.00000E+00  4.00000E+00
   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin =  -4.000000      # minimum value of y-mesh points
     ymax =   4.000000      # maximum value of y-mesh points
#    ydel =   1.000000      # mesh width of y-mesh points
       ny =      8          # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
#          -4.00000E+00 -3.00000E+00 -2.00000E+00 -1.00000E+00  0.00000E+00
#           1.00000E+00  2.00000E+00  3.00000E+00  4.00000E+00
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =   0.000000      # minimum value of z-mesh points
     zmax =   3.000000      # maximum value of z-mesh points
#    zdel =   1.000000      # mesh width of z-mesh points
       nz =      3          # number of z-mesh points
#    data = ( z(i), i = 1, nz + 1 )
#           0.00000E+00  1.00000E+00  2.00000E+00  3.00000E+00
  special =        0        # (D=0) number of repeated nuclear reactions
 material =  all            # (D=all) number of specific material
   mother =  all            # (D=all) number of specific mother
  nucleus =  all            # (D=all) number of detected nucleus
     unit =    1            # unit is [1/source]
    ndata =    1            # 0:no, 1:use ndata for 4He, 14N, 16O
     axis = dchain          # axis of output
     file = W_xyz_target.dyld   # file name of output for the above axis
     info =    0            # 0-> no, 1-> write error
     part =  all      
# kf/name :  0        
   output = cutoff          # (D=product) cutoff particles
  elastic =   -1            # (D=1) without the same target
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :       32118 (  0)           0 (  0)       32118 (  0)

