[ T i t l e ]
Sample input for shielding calculation using WWG.

[ P a r a m e t e r s ]
 icntl    =           0     # (D=0) 3:ECH 5:NOR 6:SRC 7,8:GSH 11:DSH 12:DUMP
 maxcas   =         1500    # (D=10) number of particles per one batch
 maxbch   =          100      # (D=10) number of batches

 negs     =         -1      # (D=-1) =-1:original, =0:No, =1:EGSg
 file(1)  = c:/phits        # (D=c:/phits) PHITS install folder name
 file(6)  = phits.out       # (D=phits.out) general output file name
  maxbnk  = 10000*100           # (D=10000) maximum bank memory length

 infl: {WWG2-1.out}          # output file from [t-WWG]

[ S o u r c e ]
   s-type =   1             # mono-energetic axial source
     proj =  neutron        # kind of incident nucleus          
       e0 =   6.00         # energy of beam [MeV/u]
       r0 =   1.0000        # radius [cm]
       x0 =   0.0000        # (D=0.0) center position of x-axis [cm]
       y0 =   0.0000        # (D=0.0) center position of y-axis [cm]
       z0 =  -0.1
       z1 =  -0.1
      dir = 1            

[ M a t e r i a l ]
m1     1001  1.3407e-2
       6012  1.1030e-3
       8016  4.3887e-2
      13027  1.7971e-3
      14028  1.6123e-2
      20040  1.8940e-3
      26056  3.3448e-4

[ C e l l ]
 1          1 -2.2   1 -2 -40
 2          1 -2.2   2 -3 -40
 3          1 -2.2   3 -4 -40
 4          1 -2.2   4 -5 -40
 5          1 -2.2   5 -6 -40
 6          1 -2.2   6 -7 -40
 7          1 -2.2   7 -8 -40
 8          1 -2.2   8 -9 -40
 9          1 -2.2   9 -10 -40
 10         1 -2.2   10 -11 -40
 11         1 -2.2   11 -12 -40
 12         1 -2.2   12 -13 -40

 40         0 -99  #(1 -13 -40)
 41          -1       99

[ S u r f a c e ]
set: c1[15.0]  $ cell thickness (cm)
 1            pz      0.0
 2            pz      c1
 3            pz      c1*2
 4            pz      c1*3
 5            pz      c1*4
 6            pz      c1*5
 7            pz      c1*6
 8            pz      c1*7
 9            pz      c1*8
 10           pz      c1*9
 11           pz      c1*10
 12           pz      c1*11
 13           pz      c1*12
 14           pz      c1*12+10
 40           cz      100
 99           so      500

[ T - WWG ] 
   mesh = xyz               # mesh type is region-wise
x-type = 2
  xmin = -100
  xmax =  100
    nx = 5
y-type = 2
  ymin = -100
  ymax =  100
    ny = 5
z-type = 2
  zmin =  0
  zmax =  180
    nz =  12
   part = neutron
   e-type = 1               # e-mesh is given by the below data
       ne = 2               # number of e-mesh points
     0    0.01   1e5
   axis   =  wwg            # axis of output
   #axis = xy 
    file  =  WWG2.out       # file name of output for the above axis

[ T - T r a c k ]
  mesh = xyz                # mesh type is xyz scoring mesh
x-type = 2
  xmin = -100
  xmax =  100
    nx = 100
z-type = 2
  zmin = -1
  zmax =  180
    nz = 160
y-type = 2
  ymin = -20
  ymax =  20
    ny = 1
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
            1.00000E-10  1.00000E+03
     unit =    1            # unit is [1/cm^2/source]
 material =  all            # (D=all) number of specific material
  2D-type =    7            # 1:Cont, 2:Clust, 3:Color, 4:xyz, 5:mat, 6:Clust+Cont, 7:Col+Cont
     axis =   xz            # axis of output
    gshow =    3            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
     z-txt = Effective dose (pSv/source)
     file = weight-dose-xz.out  # file name of output for the above axis
   epsout =    1            # (D=0) generate eps file by ANGEL
     part =  neutron  

  multiplier = all          # number of material group
      mat      mset1     
      all  (1.0 -202)  # Effective dose based on ICRP103 for AP (pSv.cm2)

[ T-track ] off
   mesh = xyz               # mesh type is region-wise
x-type = 2
  xmin =   
  xmax =   
    nx = 1
y-type = 2
  ymin = -10
  ymax =  10
    ny = 1
z-type = 2
  zmin =  
  zmax =  
    nz =  1
e-type = 2
  emin = 0
  emax =  100
    ne = 1
unit=1
     axis =   z             # axis of output
     file = weight-dose-z.out     # file name of output for the above axis
$   stdcut =                 # (D=-1) threshold value of STD cutoff
   y-txt  = Effective dose (pSv/source)
   epsout =    0            # (D=0) generate eps file by ANGEL
     part =  neutron

  multiplier = all          # number of material group
      mat      mset1     
      all  (1.0 -202)  # Effective dose based on ICRP103 for AP (pSv.cm2)

[END]

