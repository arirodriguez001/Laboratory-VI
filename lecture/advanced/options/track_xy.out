   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin =  -25.00000      # minimum value of y-mesh points
     ymax =   25.00000      # maximum value of y-mesh points
#    ydel =  0.5000000      # mesh width of y-mesh points
       ny =    100          # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
#          -2.50000E+01 -2.45000E+01 -2.40000E+01 -2.35000E+01 -2.30000E+01
