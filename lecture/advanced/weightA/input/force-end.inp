[ T i t l e ]  
Sample input for calculating production yield using forced collisions

[ P a r a m e t e r s ]
 icntl    =           0     # (D=0) 3:ECH 5:NOR 6:SRC 7,8:GSH 11:DSH 12:DUMP
 itall    =           1     # (D=0) 0:no tally at batch, 1:same, 2:different
 maxcas   =        5000     # (D=10) number of particles per one batch
 maxbch   =           5     # (D=10) number of batches
 emin(15) = 1.000000000E-03 # (D=1.0) cut-off energy of deuteron (MeV/u)
 emin(16) = 1.000000000E-03 # (D=1.0) cut-off energy of triton (MeV/u)
 emin(17) = 1.000000000E-03 # (D=1.0) cut-off energy of 3He (MeV/u)
 emin(18) = 1.000000000E-03 # (D=1.0) cut-off energy of Alpha (MeV/u)
 emin(19) = 1.000000000E-03 # (D=1.0) cut-off energy of Nucleus (MeV/u)
 wc2(1)   = 1.0E-12 # weight cutoff of proton
 wc2(18)  = 1.0E-12 # weight cutoff of Alpha
 wc2(19)  = 1.0E-12 # weight cutoff of Nucleus
 file(1)  = c:/phits        # (D=c:/phits) PHITS install folder name
 file(6)  = phits.out       # (D=phits.out) general output file name

[ S o u r c e ] 
  totfact =   1.0000        # (D=1.0) global factor
   s-type =   1             # mono-energetic axial source
     proj =  proton         # kind of incident particle         
       e0 =   100.00        # energy of beam [MeV]
       r0 =  0.100        # radius [cm]
       x0 =   0.0000        # (D=0.0) center position of x-axis [cm]
       y0 =   0.0000        # (D=0.0) center position of y-axis [cm]
       z0 =  -1.000        # minimum position of z-axis [cm]
       z1 =  -1.000        # maximum position of z-axis [cm]
      dir =   1.0000        # z-direction of beam [cosine]

[ M a t e r i a l ]
MAT[ 1 ] 
         28Si         1.0000000E+00
     
[ C e l l ]
 1          1 -2.3300000E+00  -120 121 -119 
 10         0                 -117 #1 #101 
 101        0                 -11 12 -13  trcl=1 
 12        -1                 117 

set: c20[30.0]   $ radius of sphere
set: c30[0.001]     $ depth of sample
set: c40[0.5]     $ radius of sample
set: c50[2.33/28*6.02e23*c30] $ target density particles/cm^2

[ S u r f a c e ]
  117       so     c20
  119       cz     c40
  120       pz     c30/2
  121       pz     -c30/2
   11  cz       2.0
   12  pz       -0.5
   13  pz      0.5

[ T r a n s f o r m ]
set: c10[0]   $ angle of around Z (degree)
set: c20[-45]   $ angle of around Y (degree)
set: c30[0]   $ angle of around X (degree)

tr1   -4 0 4
      cos(c10/180*pi)*cos(c20/180*pi)
      sin(c10/180*pi)*cos(c30/180*pi)+cos(c10/180*pi)*sin(c20/180*pi)*sin(c30/180*pi)
      sin(c10/180*pi)*sin(c30/180*pi)-cos(c10/180*pi)*sin(c20/180*pi)*cos(c30/180*pi)
     -sin(c10/180*pi)*cos(c20/180*pi)
      cos(c10/180*pi)*cos(c30/180*pi)-sin(c10/180*pi)*sin(c20/180*pi)*sin(c30/180*pi)
      cos(c10/180*pi)*sin(c30/180*pi)+sin(c10/180*pi)*sin(c20/180*pi)*cos(c30/180*pi)
      sin(c20/180*pi)
     -cos(c20/180*pi)*sin(c30/180*pi)
      cos(c20/180*pi)*cos(c30/180*pi)

[ Forced Collisions ]
   part = proton  
   reg     fcl
     1    -1.0

[ V o l u m e ]
    reg        vol
    101     pi*2*2*1

[ T - P r o d u c t ]
     mesh =  reg            # mesh type is region-wise
      reg = 1
   e-type =    3            # e-mesh is log given by emin, emax and ne
     emin =  1.0000000E-03  # minimum value of e-mesh points
     emax =   100.0000      # maximum value of e-mesh points
       ne =   50            # number of e-mesh points
   a-type =   -1            # a-mesh is given by the below data
       na =    1            # number of a-mesh points
      28.67 73.67
 material =  all            # (D=all) number of specific material
   mother =  all            # (D=all) number of specific mother
     unit =   23            # unit is [1/MeV/SR/source]
     axis =  eng            # axis of output
     file = product.out     # file name of output for the above axis
   output = nuclear         # (D=nuclear) products from all reactions
     part =  alpha      Si       
   epsout =    1            # (D=0) generate eps file by ANGEL
    factor = 1/c50*1.0E27
    y-txt = d^2\sigma/dE/d\Omega (mb/sr/MeV)
    angel = ymax(40) ymin(1e-3) ylog xlog

[ T - C r o s s ]
    title = [t-cross] in region mesh
     mesh =  reg            # mesh type is region-wise
      reg =    1            # number of crossing regions
      non     r-from r-to      area
        1     10     101       pi*2*2
   e-type =    3            # e-mesh is log given by emin, emax and ne
     emin =   1e-3      # minimum value of e-mesh points
     emax =   100.0000      # maximum value of e-mesh points
       ne =   50            # number of e-mesh points
     unit =    2            # unit is [1/cm^2/MeV/source]
     axis =  eng            # axis of output
     file = cross.out       # file name of output for the above axis
   output = flux            # surface crossing flux
     part = alpha Si
   epsout =    1            # (D=0) generate eps file by ANGEL
   factor = 5.157*5.157/c50*1.0E27
    y-txt = d^2\sigma/dE/d\Omega (mb/sr/MeV)
    angel = ymax(40) ymin(1e-3) ylog xlog

[ T - T r a c k ]
    title = Track Detection using [T-track] tally
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin =  -10.00000      # minimum value of x-mesh points
     xmax =   10.00000      # maximum value of x-mesh points
       nx =  100            # number of x-mesh points
   y-type =    1            # y-mesh is given by the below data
       ny =    1            # number of y-mesh points
           -5.0  5.0
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =  -10.00000      # minimum value of z-mesh points
     zmax =   10.00000      # maximum value of z-mesh points
       nz =  200            # number of z-mesh points
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
            0.0  5000.0
     unit =    1            # unit is [1/cm^2/source]
     axis =   xz            # axis of output
     file = track_xz.out    # file name of output for the above axis
     part = all alpha  Si   
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
   epsout =    1            # (D=0) generate eps file by ANGEL

[END]

 
