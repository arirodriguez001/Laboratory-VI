[ Title ]
 sample phits input file for autorun scripts

[ Parameters ]
 icntl    =           0     # (D=0) 3:ECH 5:NOR 6:SRC 7,8:GSH 11:DSH 12:DUMP
 maxcas   =        5000     # (D=10) number of particles per one batch
 maxbch   =           2     # (D=10) number of batches
 file(6)  = phits.out       # (D=phits.out) general output file name

[ Source ]
  totfact =   1.0000        # (D=1.0) global factor
   s-type =   1             # cylindrical source
     proj =  neutron        # kind of incident particle         
       e0 =   20.00         # energy of beam [MeV/n]
       r0 =   0.0000        # radius [cm]
       x0 =   0.0000        # (D=0.0) center position of x-axis [cm]
       y0 =   0.0000        # (D=0.0) center position of y-axis [cm]
       z0 =  -10.000        # minimum position of z-axis [cm]
       z1 =  -10.000        # maximum position of z-axis [cm]
      dir =   1.0000        # z-direction of beam [cosine]

[ Material ]
$   Concrete   2.302 g/cm^3, taken from ANL-5800 Type 02-a
$   Note: 2.302 g/cm^3 is US standard. There is no Japanese standard value,
$   but 2.1 g/cm^3 is usually used for shielding calculation
m1       H     -0.023       
         C     -0.0023
         O     -1.22
         Na    -0.0368
         Mg    -0.005
         Al    -0.078
         Si    -0.775
         K     -0.0299
         Ca    -0.1
         Fe    -0.032

[ Surface ]
  10  cz      10.
 101  pz       0.
 102  pz      50.
 999  so     500.

[ Cell ]
infl:{density.inp}
  1     1 -c1  -10  101  -102
 100    0      -999  #1
 101   -1       999

[ T-Track ]
    title = Track Detection in xyz mesh
     mesh =  r-z            # mesh type is xyz scoring mesh
   r-type =    1            # y-mesh is given by the below data
       nr =    1            # number of y-mesh points
               0  10
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
       nz =   50            # number of z-mesh points
     zmin =    0.           # minimum value of z-mesh points
     zmax =   50.           # maximum value of z-mesh points
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
            0.0  5000.0
     unit =    1            # unit is [1/cm^2/source]
     axis =   z            # axis of output
     file = track_rz.out  # file name of output for the above axis
     part =  all
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
   epsout =    2            # (D=0) generate eps file by ANGEL
    y-txt = Effective dose [pSv/source]
  multiplier = all          # number of material group
      mat      mset1
      all ( 1.0 -202 )
   angel  =  ymax(3.0)  ymin(0.01)
$ anatally start                $ Anatally subsection starts here
$ manatally = 1                 $ Type of Anatally (0: user-defined, 1:ANOVA)
$ sfile=track_rz_anatally.out   $ Anatally output file name
$ anatally end                  $ Anatally subsection ends here

[END]
