[ T i t l e ]
input file for lecture about source

[ P a r a m e t e r s ]
 icntl    =           0     # (D=0) 3:ECH 5:NOR 6:SRC 7,8:GSH 11:DSH 12:DUMP
 maxcas   =        1000    # (D=10) number of particles per one batch
 maxbch   =        100   # (D=10) number of batches
 file(1)  = c:/phits        # (D=c:/phits) PHITS install folder name
 file(6)  = phits.out       # (D=phits.out) general output file name
 negs     =           -1     # (D=-1) =-1:original, =0:No, =1:EGS

[ S o u r c e ]
  totfact =   2.0           # (D=1.0) global factor
 <Source> =   1.0000        # weight of this sub-source
   s-type =   1             # axial source with energy spectrum
     proj =  photon         # kind of incident particle         
$       e0 =   150.          # energy of beam [MeV/u]
       r0 =   0.0           # radius [cm]
       z0 =  -10.           # minimum position of z-axis [cm]
       z1 =  -10.           # maximum position of z-axis [cm]
      dir =   all           # z-direction of beam [cosine]
   e-type =  28             # RI source
       ni =   1             # number of registered nuclide
                            #  data = ( nuclide(i), activity(i), i = 1, ni )
    Co-60    100.0          # (Bq)
                            # ->  1.00000E+00 (Bq), half life:  1.66354E+08 (sec)
     norm =   0             # (D=0) normalization factor =0:(/sec) =1:(/source)
 <Source> =   1.0000        # weight of this sub-source
   s-type =   1             # axial source with energy spectrum
     proj =  photon         # kind of incident particle         
       r0 =   0.0           # radius [cm]
       z0 =   40.           # minimum position of z-axis [cm]
       z1 =   40.           # maximum position of z-axis [cm]
      dir =   all           # z-direction of beam [cosine]
   e-type =  28             # RI source
       ni =   1             # number of registered nuclide
                            #  data = ( nuclide(i), activity(i), i = 1, ni )
    Co-60    100.0          # (Bq)
                            # ->  1.00000E+00 (Bq), half life:  1.66354E+08 (sec)
     norm =   0             # (D=0) normalization factor =0:(/sec) =1:(/source)

[ M a t e r i a l ]
mat[1]    H 2  O 1

[ Mat Name Color ]
    mat   name      color
     1    Water     pastelblue

[ S u r f a c e ]
  10  so     500.
  11  cz      10.
  12  pz       0.
  13  pz      20.
  80  sz   10    1.
  300 sz  -10   0.5
  301 sz  40    0.5
  

[ C e l l ]
 100    -1      10            $ outer region
 101     1 -1.  -11  12  -13 80 $ water
 80      1  -1. -80
 300     0   -300
 301     0   -301
 110     0      -10  #101 #80 #300 #301 $ void

[ T - T r a c k ]
    title = Track Detection in xyz mesh
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
       nx =  100            # number of x-mesh points
     xmin =  -25.           # minimum value of x-mesh points
     xmax =   25.           # maximum value of x-mesh points
   y-type =    1            # y-mesh is given by the below data
       ny =    1            # number of y-mesh points
           -5.0  5.0
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
       nz =  160            # number of z-mesh points
     zmin =  -20.           # minimum value of z-mesh points
     zmax =   60.           # maximum value of z-mesh points
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
            0.0  5000.0
     unit =    1            # unit is [1/cm^2/source]
     axis =   xz            # axis of output
     file = track_xz.out    # file name of output for the above axis
     part =  all
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
   epsout =    1            # (D=0) generate eps file by ANGEL
    # cambia el texto del colorbar
   z-txt = Flux[1/cm^{2}/sec]

[ T - C r o s s ]
    title = Energy distribution in region mesh
     mesh =  reg            # mesh type is region-wise
      reg =    1            # number of crossing regions
      non     r-from  r-to       area
        1     110     101      1.000000    
   e-type =    2            # e-mesh is linear given by emin, emax and ne
     emin =   0.0           # minimum value of e-mesh points
     emax =   2.0           # maximum value of e-mesh points
       ne =  200            # number of e-mesh points
     unit =    1            # unit is [1/cm^2/source]
     axis =  eng            # axis of output
     file = cross_eng.out   # file name of output for the above axis
   output = flux            # surface crossing flux
     part =  photon   
   epsout =    1            # (D=0) generate eps file by ANGEL

 #unit 
# 0: Dose [Gy/source]; only for output=dose.
# 1: Dose [MeV/cm3/source]
# 2: Dose [MeV/source]
# 3: Number [1/source]; only for output=deposit
# 4: Number [1/nsec/source]; only for output=deposit
# 5: Dose [J/m3/source]; only for output=dose 
   
      
    [ T - Deposit ]
    title = Deposition energy in reg mesh
     mesh =  reg            # mesh type is region-wise       
     reg =  80        	    
	 unit =    0            # unit is [Gy/source]
 material =  all            # (D=all) number of specific material
   output =  dose           # total deposit energy
     axis =   reg           # axis of output
     file = dose-Gy.out     # file name of output for the above axis
     part =  photon
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
    epsout =   1
    letmat =   1
    y-txt= Dose [Gy/s]
    
    
    [t-product] 
     title = Source-Reg 
      mesh =  reg            # mesh type is region-wise
       reg= 300 301
     unit =    1            # unit is [1/source]
 material =  all      
     axis =   reg     
   output =  source          # total deposit energy
     file = source_distribution.out   # file name of output for the above axis
     part =  photon       
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
   epsout =    1            # (D=0) generate eps file by ANGEL   
   e-type =    1            # e-mesh is log given by emin, emax and ne
       ne =    1            # number of e-mesh points
           0.0  3
      y-txt=Source [1/s] 

[ E n d ]
