[ T-Product ]
    title = Source-Reg
     mesh =  reg            # mesh type is region-wise
      reg = 300 301
   e-type =    1            # e-mesh is given by the below data
       ne =      1          # number of e-mesh points
#    data = ( e(i), i = 1, ne + 1 )
            0.00000E+00  3.00000E+00
 material =  all            # (D=all) number of specific material
   mother =  all            # (D=all) number of specific mother
     unit =    1            # unit is [1/source]
     axis =  reg            # axis of output
     file = source_distribution.out  # file name of output for the above axis
   output = source          # (D=nuclear) source distribution
     part =  photon   
# kf/name :  22       
    y-txt = Source [1/s] 
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat 5:bmp style
    resol =    1            # (D=1) resolution of gshow or rshow
    width = 0.5000000       # (D=0.5) width of lines for gshow or rshow
   epsout =    1            # (D=0) generate eps file by ANGEL
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :           8 (  0)           0 (  0)           8 (  0)

#------------------------------------------------------------------------------
#newpage:
#   no. =  1   ie  =  1
#   e = (   0.0000E+00  -   3.0000E+00  )

x: Serial Num. of Region
y: Source [1/s] 2222
p: xlin ylog afac(0.8) form(0.9)
h:   x      n     n          y(photon  ),l3   n   
#  num    reg     volume     photon      r.err 
    1     300   1.0000E+00   2.0018E+02  0.0032
    2     301   1.0000E+00   1.9984E+02  0.0032

#   sum over    1.0000E+00   4.0002E+02

'no. =  1,  e =  1'
msuc: {\huge Source-Reg}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.29}
wt: s(0.7)
\vspace{-3}
  emin  &=&   0.0000E+00 [MeV]
  emax  &=&   3.0000E+00 [MeV]
e:
 
# Information for Restart Calculation
# This calculation was newly started
# istdev =  2 # 1:Batch variance, 2:History variance
# resc2  = 2.49987431118540997E+02 # Total source weight or Total source weight / maxcas
# resc3  = 1.00000000000000000E+05 # Total history number or Total batch number
# maxcas =        1000 # History / Batch, only used for istdev=1
# bitrseed = 0001110011011001101111011000110011100000010010101010010011101100 # bit data of rseed
