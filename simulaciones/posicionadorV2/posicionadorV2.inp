[ T i t l e ]
Modulo acrilico posicionador Hamsters

[ P a r a m e t e r s ]
icntl    =          8     $ 3:ECH 5:NOR 6:SRC 7,8:GSH 11:DSH 12:DUMP
maxcas   =          50    $ number of particles per one batch
maxbch   =          200   $ number of batches

[ S o u r c e ]
s-type =   1
proj =  proton
dir =   1.0
r0 =   0.
z0 =  -1.
z1 =  -1.
e0 =   150.

[ M a t e r i a l ]
mat[1]  C 5 H 8 O 2     $ acrilico

[ S u r f a c e ]
$ Caras exteriores
1  px   0.0
2  px  15.0
3  py   0.0
4  py   5.0
5  pz   0.0
6  pz   5.0

$ Hueco interior (3 mm)
11  px   0.3
12  px  14.7
13  py   0.3
14  py   4.7
15  pz   0.3
16  pz   4.7

$ Soporte del pouch
21  px  15.0
22  px  20.0
23  py   0.5
24  py   4.5
25  pz   2.25
26  pz   2.75

$ Limite de la geometria
101  so  30.0


[ C e l l ]
100   1  -1.18   +1 -2 +3 -4 +5 -6 #200 #300
200   0          11 -12 13 -14 15 -16
300   1  -1.18   21 -22 23 -24 25 -26

1000  0         -101 #100 #200 #300
1001 -1          101

[ T - T r a c k ]
mesh = xyz

x-type = 2
nx = 200
xmin = -5.
xmax = 25.

y-type = 2
ny = 200
ymin = -5.
ymax = 10.

z-type = 1
nz = 1
2.0 3.0

part = all

e-type = 1
ne = 1
0.0 1000.0

unit = 1
axis = xy
file = track_xy.out
gshow = 3
epsout = 1

[ T - T r a c k ]
mesh = xyz

x-type = 2
nx = 200
xmin = -1.
xmax = 23.

y-type = 1
ny = 1
0.0 5.0

z-type = 2
nz = 200
zmin = -3.
zmax = 7.

part = all

e-type = 1
ne = 1
0.0 1000.0

unit = 1
axis = xz
file = track_xz.out
gshow = 3
epsout = 1

[ E n d ]
