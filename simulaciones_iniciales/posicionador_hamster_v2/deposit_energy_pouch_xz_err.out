[ T-Deposit ]
    title = Deposit vs Energy in Pouch Slice
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin = -0.2000000      # minimum value of x-mesh points
     xmax =  0.2000000      # maximum value of x-mesh points
#    xdel =  0.4000000      # mesh width of x-mesh points
       nx =      1          # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
#          -2.00000E-01  2.00000E-01
   y-type =    1            # y-mesh is given by the below data
       ny =      1          # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
           -5.00000E-02  5.00000E-02
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =  -1.000000      # minimum value of z-mesh points
     zmax =   1.000000      # maximum value of z-mesh points
#    zdel =  2.0000000E-02  # mesh width of z-mesh points
       nz =    100          # number of z-mesh points
#    data = ( z(i), i = 1, nz + 1 )
#          -1.00000E+00 -9.80000E-01 -9.60000E-01 -9.40000E-01 -9.20000E-01
#          -9.00000E-01 -8.80000E-01 -8.60000E-01 -8.40000E-01 -8.20000E-01
#          -8.00000E-01 -7.80000E-01 -7.60000E-01 -7.40000E-01 -7.20000E-01
#          -7.00000E-01 -6.80000E-01 -6.60000E-01 -6.40000E-01 -6.20000E-01
#          -6.00000E-01 -5.80000E-01 -5.60000E-01 -5.40000E-01 -5.20000E-01
#          -5.00000E-01 -4.80000E-01 -4.60000E-01 -4.40000E-01 -4.20000E-01
#          -4.00000E-01 -3.80000E-01 -3.60000E-01 -3.40000E-01 -3.20000E-01
#          -3.00000E-01 -2.80000E-01 -2.60000E-01 -2.40000E-01 -2.20000E-01
#          -2.00000E-01 -1.80000E-01 -1.60000E-01 -1.40000E-01 -1.20000E-01
#          -1.00000E-01 -8.00000E-02 -6.00000E-02 -4.00000E-02 -2.00000E-02
#           0.00000E+00  2.00000E-02  4.00000E-02  6.00000E-02  8.00000E-02
#           1.00000E-01  1.20000E-01  1.40000E-01  1.60000E-01  1.80000E-01
#           2.00000E-01  2.20000E-01  2.40000E-01  2.60000E-01  2.80000E-01
#           3.00000E-01  3.20000E-01  3.40000E-01  3.60000E-01  3.80000E-01
#           4.00000E-01  4.20000E-01  4.40000E-01  4.60000E-01  4.80000E-01
#           5.00000E-01  5.20000E-01  5.40000E-01  5.60000E-01  5.80000E-01
#           6.00000E-01  6.20000E-01  6.40000E-01  6.60000E-01  6.80000E-01
#           7.00000E-01  7.20000E-01  7.40000E-01  7.60000E-01  7.80000E-01
#           8.00000E-01  8.20000E-01  8.40000E-01  8.60000E-01  8.80000E-01
#           9.00000E-01  9.20000E-01  9.40000E-01  9.60000E-01  9.80000E-01
#           1.00000E+00
     unit =    3            # unit is [1/source] : only for output=deposit
   letmat =    0            # (D=0) mat ID for LET, 0:real mat, <0: electron for H2O
  dedxfnc =    0            # (D=0) user defined multiplier, 0(no), 1, 2
 material =  all            # (D=all) number of specific material
   output = deposit         # deposit enerygy distribution
  deposit =    0            # (D=0) 0-> total deposit dist, 1-> each process
   e-type =    2            # e-mesh is linear given by emin, emax and ne
     emin =   0.000000      # minimum value of e-mesh points
     emax =   20.00000      # maximum value of e-mesh points
#    edel =   2.000000      # mesh width of e-mesh points
       ne =     10          # number of e-mesh points
#    data = ( e(i), i = 1, ne + 1 )
#           0.00000E+00  2.00000E+00  4.00000E+00  6.00000E+00  8.00000E+00
#           1.00000E+01  1.20000E+01  1.40000E+01  1.60000E+01  1.80000E+01
#           2.00000E+01
  2D-type =    3            # 1:Cont, 2:Clust, 3:Color, 4:xyz, 5:mat, 6:Clust+Cont, 7:Col+Cont
     axis =    xz           # axis of output
     file = deposit_energy_pouch_xz.out  # file name of output for the above axis
     part =  all      
# kf/name :  0        
    gshow =    3            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat 5:bmp style
    resol =    1            # (D=1) resolution of gshow or rshow
    width = 0.5000000       # (D=0.5) width of lines for gshow or rshow
   epsout =    1            # (D=0) generate eps file by ANGEL
   mother =  all            # (D=all) number of specific mother
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :         118 (  0)           0 (  0)         118 (  0)

#------------------------------------------------------------------------------
#newpage:
#   no. =  1   ie  =  1   iy  =  1   part. = all     
#   e = (   0.0000E+00  -   2.0000E+00  )
#   y = (  -5.0000E-02  -   5.0000E-02  )

'no. =  1,  ie =  1,  iy =  1'
msuc: {\huge Deposit vs Energy in Pouch Slice}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.35}

x: z [cm]
y: x [cm]
set: c1[ 0.200] c2[ 2.012] c5[ 0.800] c6[ 0.569] c7[ 0.000] c8[ 1.600]
p: h2fs form[c1] xfac[c2] afac[c5] scal[c6] xorg[c7] yorg[c8] nosp
p: xmin( -1.000000    ) xmax(  1.000000    )
p: ymin(-0.2000000    ) ymax( 0.2000000    )
#  nx =   1   nz = 100
# ( ( data(z,x), z = 1, nz ), x = nx, 1, -1 )

