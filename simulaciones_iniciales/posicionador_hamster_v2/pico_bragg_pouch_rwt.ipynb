"#---factordeescalareal---\n",
"corriente_na=1.0\n",
"tiempo_s=600#ajustar\n",
"n_total=(corriente_na*1e-9/1.602177e-19)*tiempo_s#ntot=(i/e).tusei=q/t"
]
},
