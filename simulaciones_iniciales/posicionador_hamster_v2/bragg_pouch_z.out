[ T-Deposit ]
    title = Bragg peak in pouch
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    1            # x-mesh is given by the below data
       nx =      1          # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
           -5.00000E-02  5.00000E-02
   y-type =    1            # y-mesh is given by the below data
       ny =      1          # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
           -5.00000E-02  5.00000E-02
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin = -0.5000000      # minimum value of z-mesh points
     zmax =  0.5000000      # maximum value of z-mesh points
#    zdel =  2.0000000E-02  # mesh width of z-mesh points
       nz =     50          # number of z-mesh points
#    data = ( z(i), i = 1, nz + 1 )
#          -5.00000E-01 -4.80000E-01 -4.60000E-01 -4.40000E-01 -4.20000E-01
#          -4.00000E-01 -3.80000E-01 -3.60000E-01 -3.40000E-01 -3.20000E-01
#          -3.00000E-01 -2.80000E-01 -2.60000E-01 -2.40000E-01 -2.20000E-01
#          -2.00000E-01 -1.80000E-01 -1.60000E-01 -1.40000E-01 -1.20000E-01
#          -1.00000E-01 -8.00000E-02 -6.00000E-02 -4.00000E-02 -2.00000E-02
#           0.00000E+00  2.00000E-02  4.00000E-02  6.00000E-02  8.00000E-02
#           1.00000E-01  1.20000E-01  1.40000E-01  1.60000E-01  1.80000E-01
#           2.00000E-01  2.20000E-01  2.40000E-01  2.60000E-01  2.80000E-01
#           3.00000E-01  3.20000E-01  3.40000E-01  3.60000E-01  3.80000E-01
#           4.00000E-01  4.20000E-01  4.40000E-01  4.60000E-01  4.80000E-01
#           5.00000E-01
     unit =    0            # unit is [Gy/source]
   letmat =    0            # (D=0) mat ID for LET, 0:real mat, <0: electron for H2O
  dedxfnc =    0            # (D=0) user defined multiplier, 0(no), 1, 2
 material =  all            # (D=all) number of specific material
   output =  dose           # total deposit energy
  deposit =    0            # (D=0) 0-> total deposit dist, 1-> each process
     axis =     z           # axis of output
     file = bragg_pouch_z.out  # file name of output for the above axis
     part =  proton   
# kf/name :  2212     
   epsout =    1            # (D=0) generate eps file by ANGEL
   mother =  all            # (D=all) number of specific mother
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :          58 (  0)           0 (  0)          58 (  0)

