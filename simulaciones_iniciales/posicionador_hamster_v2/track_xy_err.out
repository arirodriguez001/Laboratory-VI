[ T-Track ]
    title = [t-track] in xyz mesh
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin =  -20.00000      # minimum value of x-mesh points
     xmax =   5.000000      # maximum value of x-mesh points
#    xdel =  0.2500000      # mesh width of x-mesh points
       nx =    100          # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
#          -2.00000E+01 -1.97500E+01 -1.95000E+01 -1.92500E+01 -1.90000E+01
#          -1.87500E+01 -1.85000E+01 -1.82500E+01 -1.80000E+01 -1.77500E+01
