[ T - D e p o s i t ] off
title = Deposit vs Energy in Pouch Slice
mesh = xyz
x-type = 2
nx = 1
xmin = -0.2
xmax = 0.2
y-type = 1
ny = 1
-0.05 0.05
z-type = 2
nz = 100
zmin = -1.0
zmax = 1.0
e-type = 2
ne = 10
emin = 0.0
emax = 20.0
part = all
output = deposit
unit = 3
axis = xz
file = deposit_energy_pouch_xz.out
gshow = 3
epsout = 1

[ T - D e p o s i t ] off
title = Bragg peak in pouch

mesh = xyz

x-type = 1
nx = 1
-0.05 0.05

y-type = 1
ny = 1
-0.05 0.05

z-type = 2
nz = 500
zmin = -0.5
zmax = 0.5

part = proton
output = dose
unit = 0
axis = z
file = bragg_pouch_z.out
epsout = 1

[ T - D e p o s i t ] $ Mismo Tdeposit que el anterior solo que con mesh cilind
title = Bragg peak in pouch
mesh = r-z

r-type =    2           $ Malla radial (sustituye a x e y)
rmin   =    0.0         $ Desde el centro del haz
rmax   =    0.5         $ Radio de 0.5 cm (coincide con tu r0 de la fuente)
nr     =    1           $ Un solo bin radial para integrar toda la dosis del haz

z-type =    2           $ Eje de profundidad (Z)
zmin   =   -0.5
zmax   =    0.5
nz     =    500         $ Mantenemos alta resolucion para el grafico de Python

part = proton
output = dose
unit = 0
axis = z
file = bragg_pouch_zcilind.out
epsout = 1

[ T - D e p o s i t ] off
