file = deposit_pouch_z.out
     part = all $ Las partículas que te interese trackear


[ T - D e p o s i t ] off 
title = Bragg peak in pouch
mesh = xyz
   x-type =  2
       nx =  1
     xmin = -7    $ Ajustá a las dimensiones de tu haz
     xmax =  7
   y-type =  2
       ny =  1
     ymin = -7
     ymax =  7
   z-type =  1
       nz =  1
    60.58  60.63   $ Tu plano Z de interés (rebanada fina)
     unit =  0      $ Resultado en MeV/source o Gy/source
   output =  energy $ 'dose' para Gy, 'energy' para MeV totales en el volumen
     axis =  z
     file =  avg_energy_z.out
     part =  proton

