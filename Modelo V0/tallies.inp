[ T-Track ] off
title	= Particle track
mesh	= xyz
x-type	= 4
xdel	= 0.1
xmin	= -6.67
xmax	=  6.67
y-type	= 1
  ny	= 1
		-6.67  6.67
z-type	= 4
zdel	= 0.1
zmin	= -5.0
zmax	=  102.5
e-type	= 1
  ne	= 1
		0.0  1000
part	= proton
axis	= zx
2d-type = 3
file	= Flux%thisdata%.out
unit	= 1
epsout	= 2
gshow	= 1	$ 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
stdcut	= 0.01


[ T-Deposit ] off
title	= Dose per region
mesh	= reg
 reg	= 2505 2506
unit	= 0	$ unit is [Gy/source]
axis	= reg	$ axis of output
output	= dose	$ total deposit energy
file	= Dose%thisdata%.out	$ file name of output for the above axis
part	= all
epsout	= 0
stdcut	= 0.01


[ T-Deposit ] off
$$factor	= -1
title	= Bragg peak in medium
mesh	= r-z 
r-type	= 1
  nr	= 4
			0.0 (0.500*c62) (0.707*c62) (0.866*c62) (c62)
z-type	= 4
zdel	= (c68)
zmin	= 0.0 
zmax	= (c601)  
material = 2
			8  12
unit	= 0	$ unit is [Gy/source]
output	= dose	$ total deposit energy
axis	= z	$ axis of output
file	= Bragg_peak%thisdata%.out	$ file name of output for the above axis
part	= all
epsout	= 2
angel	= ylin
trcl	= 62
stdcut	= 0.01


[ T-Deposit ] off
factor	= -1
title	= Radial dose uniformity at monolayer cells
mesh	= r-z 
r-type	= 2
  nr	= 50
rmin	= 0.0
rmax	= (c62)
z-type	= 1
  nz	= 1
		(0.0)   (c68)
material = 1
			12
unit	= 0	$ unit is [Gy/source]
output	= dose	$ total deposit energy
axis	= r	$ axis of output
file	= Un_r%thisdata%.out	$ file name of output for the above axis
part	= all
gshow	= 1	$ 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
$2D-type	= 3	$1: contour plot	2: cluster plot	3: color plot	6: cluster and contour plot	7: color and contour plot.
epsout	= 2
angel	= ylin
$angel	= zlin form(0.75) xfac(1.0) afac(1.0) scal(0.9)
trcl	= 61
stdcut	= 0.01


[ T-Deposit ] off
factor	= -1
title	= xy uniformity
mesh	= xyz 
x-type	= 2
  nx	= 20
xmin	= -c62
xmax	=  c62
y-type	= 2
  ny	= 20
ymin	= -c62
ymax	=  c62
z-type	= 2
  nz	= 20
zmin	= 0.0 
zmax	= (c601)  
material = 2
			8  12
unit	= 0	$ unit is [Gy/source]
output	= dose	$ total deposit energy
axis	= xy	$ axis of output
file	= Un_xy%thisdata%.out	$ file name of output for the above axis
part	= all
gshow	= 1	$ 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
2D-type	= 3	$1: contour plot	2: cluster plot	3: color plot	6: cluster and contour plot	7: color and contour plot.
epsout	= 1	$ (D=0) generate eps file by ANGEL
angel	= ylin
trcl	= 62
$stdcut	= 0.01


[ T-Yield ] off
title	= Activation yield
mesh	= reg
 reg	= 104 2101 ( 2104 < 2103 < 2102 ) 2106 2107 2201 2301 
			2401 2501 2502 2503 2504 2506 2603 (2606 < 2605 < 2604) 
volume
 reg	vol
 1000001	%vol_atgrid%
 1000002	%vol_rfgrid%

material = -1
			1	$to exclude air
axis	= dchain
info	= 1
file	= Act_dchain%thisdata%.out
unit	= 1
epsout	= 2
stdcut	= 0.01


[T-DCHAIN] off 
title	= Activation of materials 
mesh	= reg
 reg	= 104 2101 ( 2104 < 2103 < 2102 ) 2106 2107 2201 2301 
			2401 2501 2502 2503 2504 2506 2603 (2606 < 2605 < 2604)
file	= Act_%thisdata%.out
stdcut	= 0.01 
timeevo	= 2 
