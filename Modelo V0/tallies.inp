[ T - D e p o s i t ]  off$ Mismo Tdeposit que el anterior solo que con mesh cilind
title = Bragg peak in pouch
mesh = r-z

r-type =    2           $ Malla radial (sustituye a x e y)
rmin   =    0.0         $ Desde el centro del haz
rmax   =    0.5         $ Radio de 0.5 cm (coincide con tu r0 de la fuente)
nr     =    1           $ Un solo bin radial para integrar toda la dosis del haz

z-type =    2           $ Eje de profundidad (Z)
zmin   =    60.33
zmax   =    61.0
nz     =    100      $ Mantenemos alta resolucion para el grafico de Python

part = proton
output = dose
unit = 0
axis = z
file = bragg_pouch_zcilindJesus.out
epsout = 1

[ T - Track ]  off $Medimos espectro de energía
    title = Espectro de energía
     mesh =  reg           $ Tally por región (celda)
      reg =  510 600 6003      $ Tu celda del pouch
    e-type =  2            $ Mesh logarítmico
       ne =  100           $ Número de divisiones (bins)
     emin =  1.0e-9        $ Energía mínima (ej. 1e-9 MeV para neutrones)
     emax =  25.0         $ Energía máxima (el dmax de tu problema)
     unit =  1             $ Resultado en 1/cm2/source
     axis =  eng           $ El eje X será la energía
     file = energy_pouch.out
     part = proton neutron alpha photon positron $ Las partículas que te interese trackear

