[ T-Deposit ]
    title = Energia depositada en el pouch
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin =  -7.000000      # minimum value of x-mesh points
     xmax =   7.000000      # maximum value of x-mesh points
#    xdel =   14.00000      # mesh width of x-mesh points
       nx =      1          # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
#          -7.00000E+00  7.00000E+00
   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin =  -7.000000      # minimum value of y-mesh points
     ymax =   7.000000      # maximum value of y-mesh points
#    ydel =   14.00000      # mesh width of y-mesh points
       ny =      1          # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
#          -7.00000E+00  7.00000E+00
   z-type =    1            # z-mesh is given by the below data
       nz =      1          # number of z-mesh points
#    data = ( z(i), i = 1, nz + 1 )
            6.06300E+01  6.07300E+01
     unit =    3            # unit is [1/source] : only for output=deposit
   letmat =    0            # (D=0) mat ID for LET, 0:real mat, <0: electron for H2O
  dedxfnc =    0            # (D=0) user defined multiplier, 0(no), 1, 2
 material =  all            # (D=all) number of specific material
   output = deposit         # deposit enerygy distribution
  deposit =    0            # (D=0) 0-> total deposit dist, 1-> each process
   e-type =    1            # e-mesh is given by the below data
       ne =      1          # number of e-mesh points
#    data = ( e(i), i = 1, ne + 1 )
            0.00000E+00  1.00000E+03
     axis =     z           # axis of output
     file = deposit_pouch_z_M0.out  # file name of output for the above axis
     part =  proton     all      
# kf/name :  2212       0        
   mother =  all            # (D=all) number of specific mother
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :          10 (  0)           0 (  0)          10 (  0)

#------------------------------------------------------------------------------
#newpage:
#   no. =  1   ie  =  1   ix  =  1   iy  =  1
#   e = (   0.0000E+00  -   1.0000E+03  )
#   x = (  -7.0000E+00  -   7.0000E+00  )
#   y = (  -7.0000E+00  -   7.0000E+00  )

x: z[cm]
y: Number [1/source]     
p: xlin ylog afac(0.8) form(0.9)
h: n            x            y(proton  ),hh0l n y(all     ),hh0dr n 
#  z-lower      z-upper        proton    r.err      all       r.err 
   6.0630E+01   6.0730E+01   8.2124E+07  0.0027   8.2131E+07  0.0028

#   sum over                 8.2124E+07  0.0027   8.2131E+07  0.0028

'no. =  1,  ie =  1,  ix =  1,  iy =  1'
msuc: {\huge Energia depositada en el pouch}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.35}
wt: s(0.7)
\vspace{-3}
   emin &=&   0.0000E+00 [keV/um]
   emax &=&   1.0000E+03 [keV/um]
  xmin  &=&  -7.0000E+00 [cm]
  xmax  &=&   7.0000E+00 [cm]
  ymin  &=&  -7.0000E+00 [cm]
  ymax  &=&   7.0000E+00 [cm]
e:
 
# Information for Restart Calculation
# This calculation was newly started
# istdev =  2 # 1:Batch variance, 2:History variance
# resc2  = 1.60217700001159249E-03 # Total source weight or Total source weight / maxcas
# resc3  = 1.00000000000000000E+07 # Total history number or Total batch number
# maxcas =       10000 # History / Batch, only used for istdev=1
# bitrseed = 1000110000001000111111101100101001110101110010000011011101101000 # bit data of rseed
