[ T-Deposit ]
    title = Histograma
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin =  -1.000000      # minimum value of x-mesh points
     xmax =   1.000000      # maximum value of x-mesh points
#    xdel =  0.2000000      # mesh width of x-mesh points
       nx =     10          # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
#          -1.00000E+00 -8.00000E-01 -6.00000E-01 -4.00000E-01 -2.00000E-01
#           0.00000E+00  2.00000E-01  4.00000E-01  6.00000E-01  8.00000E-01
#           1.00000E+00
   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin =  -1.600000      # minimum value of y-mesh points
     ymax =   1.600000      # maximum value of y-mesh points
#    ydel =  0.2000000      # mesh width of y-mesh points
       ny =     16          # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
#          -1.60000E+00 -1.40000E+00 -1.20000E+00 -1.00000E+00 -8.00000E-01
#          -6.00000E-01 -4.00000E-01 -2.00000E-01  0.00000E+00  2.00000E-01
#           4.00000E-01  6.00000E-01  8.00000E-01  1.00000E+00  1.20000E+00
#           1.40000E+00  1.60000E+00
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =   98.38000      # minimum value of z-mesh points
     zmax =   98.58000      # maximum value of z-mesh points
#    zdel =  5.0000000E-02  # mesh width of z-mesh points
       nz =      4          # number of z-mesh points
#    data = ( z(i), i = 1, nz + 1 )
#           9.83800E+01  9.84300E+01  9.84800E+01  9.85300E+01  9.85800E+01
     unit =    0            # unit is [Gy/source]
   letmat =    0            # (D=0) mat ID for LET, 0:real mat, <0: electron for H2O
  dedxfnc =    0            # (D=0) user defined multiplier, 0(no), 1, 2
 material =  all            # (D=all) number of specific material
   output =  dose           # total deposit energy
  deposit =    0            # (D=0) 0-> total deposit dist, 1-> each process
     axis =     z           # axis of output
     file = histograma_dosis_M0.out  # file name of output for the above axis
     part =  proton   
# kf/name :  2212     
   epsout =    1            # (D=0) generate eps file by ANGEL
   mother =  all            # (D=all) number of specific mother
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :          36 (  0)           0 (  0)          36 (  0)

#------------------------------------------------------------------------------
#newpage:
#   no. =  1   ix  =  1   iy  =  1
#   x = (  -1.0000E+00  -  -8.0000E-01  )
#   y = (  -1.6000E+00  -  -1.4000E+00  )

x: z[cm]
y: Dose [Gy/source]      
p: xlin ylog afac(0.8) form(0.9)
h: n            x            y(proton  ),hh0l n 
#  z-lower      z-upper        proton    r.err 
   9.8380E+01   9.8430E+01   5.8563E-03  0.0182
   9.8430E+01   9.8480E+01   5.9574E-03  0.0185
   9.8480E+01   9.8530E+01   5.9103E-03  0.0185
   9.8530E+01   9.8580E+01   5.8542E-03  0.0179

#   sum over    8.0000E-03   5.8945E-03  0.0152

'no. =  1,  ix =  1,  iy =  1'
msuc: {\huge Histograma}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.35}
wt: s(0.7)
\vspace{-3}
  xmin  &=&  -1.0000E+00 [cm]
  xmax  &=&  -8.0000E-01 [cm]
  ymin  &=&  -1.6000E+00 [cm]
  ymax  &=&  -1.4000E+00 [cm]
