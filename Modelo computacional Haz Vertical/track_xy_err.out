#           3.20000E+00  3.36000E+00  3.52000E+00  3.68000E+00  3.84000E+00
#           4.00000E+00
   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin =  -7.000000      # minimum value of y-mesh points
     ymax =   7.000000      # maximum value of y-mesh points
#    ydel =  0.1750000      # mesh width of y-mesh points
       ny =     80          # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
#          -7.00000E+00 -6.82500E+00 -6.65000E+00 -6.47500E+00 -6.30000E+00
#          -6.12500E+00 -5.95000E+00 -5.77500E+00 -5.60000E+00 -5.42500E+00
