[ T-Track ]
    title = [t-track] in xyz mesh
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin =  -4.000000      # minimum value of x-mesh points
     xmax =   4.000000      # maximum value of x-mesh points
#    xdel =  0.1600000      # mesh width of x-mesh points
       nx =     50          # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
#          -4.00000E+00 -3.84000E+00 -3.68000E+00 -3.52000E+00 -3.36000E+00
#          -3.20000E+00 -3.04000E+00 -2.88000E+00 -2.72000E+00 -2.56000E+00
#          -2.40000E+00 -2.24000E+00 -2.08000E+00 -1.92000E+00 -1.76000E+00
#          -1.60000E+00 -1.44000E+00 -1.28000E+00 -1.12000E+00 -9.60000E-01
#          -8.00000E-01 -6.40000E-01 -4.80000E-01 -3.20000E-01 -1.60000E-01
#           0.00000E+00  1.60000E-01  3.20000E-01  4.80000E-01  6.40000E-01
#           8.00000E-01  9.60000E-01  1.12000E+00  1.28000E+00  1.44000E+00
#           1.60000E+00  1.76000E+00  1.92000E+00  2.08000E+00  2.24000E+00
#           2.40000E+00  2.56000E+00  2.72000E+00  2.88000E+00  3.04000E+00
#           3.20000E+00  3.36000E+00  3.52000E+00  3.68000E+00  3.84000E+00
#           4.00000E+00
   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin =  -5.000000      # minimum value of y-mesh points
     ymax =   5.000000      # maximum value of y-mesh points
#    ydel =  0.1250000      # mesh width of y-mesh points
       ny =     80          # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
#          -5.00000E+00 -4.87500E+00 -4.75000E+00 -4.62500E+00 -4.50000E+00
#          -4.37500E+00 -4.25000E+00 -4.12500E+00 -4.00000E+00 -3.87500E+00
#          -3.75000E+00 -3.62500E+00 -3.50000E+00 -3.37500E+00 -3.25000E+00
#          -3.12500E+00 -3.00000E+00 -2.87500E+00 -2.75000E+00 -2.62500E+00
#          -2.50000E+00 -2.37500E+00 -2.25000E+00 -2.12500E+00 -2.00000E+00
#          -1.87500E+00 -1.75000E+00 -1.62500E+00 -1.50000E+00 -1.37500E+00
#          -1.25000E+00 -1.12500E+00 -1.00000E+00 -8.75000E-01 -7.50000E-01
#          -6.25000E-01 -5.00000E-01 -3.75000E-01 -2.50000E-01 -1.25000E-01
#           0.00000E+00  1.25000E-01  2.50000E-01  3.75000E-01  5.00000E-01
#           6.25000E-01  7.50000E-01  8.75000E-01  1.00000E+00  1.12500E+00
#           1.25000E+00  1.37500E+00  1.50000E+00  1.62500E+00  1.75000E+00
#           1.87500E+00  2.00000E+00  2.12500E+00  2.25000E+00  2.37500E+00
#           2.50000E+00  2.62500E+00  2.75000E+00  2.87500E+00  3.00000E+00
#           3.12500E+00  3.25000E+00  3.37500E+00  3.50000E+00  3.62500E+00
#           3.75000E+00  3.87500E+00  4.00000E+00  4.12500E+00  4.25000E+00
#           4.37500E+00  4.50000E+00  4.62500E+00  4.75000E+00  4.87500E+00
#           5.00000E+00
   z-type =    1            # z-mesh is given by the below data
       nz =      1          # number of z-mesh points
#    data = ( z(i), i = 1, nz + 1 )
            9.84700E+01  9.84900E+01
   e-type =    1            # e-mesh is given by the below data
       ne =      1          # number of e-mesh points
#    data = ( e(i), i = 1, ne + 1 )
            0.00000E+00  1.00000E+03
     unit =    1            # unit is [1/cm^2/source]
 material =  all            # (D=all) number of specific material
  2D-type =    3            # 1:Cont, 2:Clust, 3:Color, 4:xyz, 5:mat, 6:Clust+Cont, 7:Col+Cont
     axis =      xy            # axis of output
     file = track_xy.out    # file name of output for the above axis
     part =  proton   
# kf/name :  2212     
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat 5:bmp style
    resol =    1            # (D=1) resolution of gshow or rshow
    width = 0.5000000       # (D=0.5) width of lines for gshow or rshow
   epsout =    1            # (D=0) generate eps file by ANGEL
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :         140 (  0)           0 (  0)         140 (  0)

#------------------------------------------------------------------------------
#newpage:
#   no. =  1   ie  =  1   iz  =  1   part. = proton  
#   e = (   0.0000E+00  -   1.0000E+03  )
#   z = (   9.8470E+01  -   9.8490E+01  )

'no. =  1,  ie =  1,  iz =  1'
msuc: {\huge [t-track] in xyz mesh}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.35}

x: x [cm]
y: y [cm]
set: c1[ 1.250] c2[ 0.805] c5[ 0.800] c6[ 0.913] c7[ 0.167] c8[ 0.000]
p: h2fs form[c1] xfac[c2] afac[c5] scal[c6] xorg[c7] yorg[c8] nosp
set: c3[1.0e-4] c4[1.0]
p: cmin[c3] cmax[c4]
p: dmin(1e-31)
p: zlog
p: xmin( -4.000000    ) xmax(  4.000000    )
p: ymin( -5.000000    ) ymax(  5.000000    )
