[ T-Track ]
    title = Flujo de partículas en coordenadas cilindricas a z = 1.10 cm
     mesh =  r-z            # mesh type is r-z scoring mesh
       x0 =   0.000000      # center x-position of r-z mesh
       y0 =   0.000000      # center y-position of r-z mesh
   r-type =    4            # r-mesh is linear given by rmin, rmax and rdel
     rmin =   0.000000      # minimum value of r-mesh points
     rmax =   6.670000      # maximum value of r-mesh points
     rdel =  0.1000000      # mesh width of r-mesh points
#      nr =   67            # number of r-mesh points
#    data = ( r(i), i = 1, nr + 1 )
