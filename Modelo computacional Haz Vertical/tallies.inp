ny =1 
ymin    = -6.67
ymax    =  6.67

z-type  = 1
nz      = 1
         1.05 1.15

e-type  = 2
ne      = 100
emin    = 0.0
emax    = 25.0

part    = proton
axis    = xy
2d-type = 3
file    = Flux_energy_z1_10.out
unit    = 1
epsout  = 2
gshow   = 1
stdcut  = 0.01