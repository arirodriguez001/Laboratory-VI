[ T-Deposit ]
    title = Bragg peak in pouch
     mesh =  r-z            # mesh type is r-z scoring mesh
       x0 =   0.000000      # center x-position of r-z mesh
       y0 =   0.000000      # center y-position of r-z mesh
   r-type =    2            # r-mesh is linear given by rmin, rmax and nr
     rmin =   0.000000      # minimum value of r-mesh points
     rmax =   1.600000      # maximum value of r-mesh points
#    rdel =  1.6000000E-02  # mesh width of r-mesh points
       nr =    100          # number of r-mesh points
#    data = ( r(i), i = 1, nr + 1 )
#           0.00000E+00  1.60000E-02  3.20000E-02  4.80000E-02  6.40000E-02
#           8.00000E-02  9.60000E-02  1.12000E-01  1.28000E-01  1.44000E-01
#           1.60000E-01  1.76000E-01  1.92000E-01  2.08000E-01  2.24000E-01
#           2.40000E-01  2.56000E-01  2.72000E-01  2.88000E-01  3.04000E-01
#           3.20000E-01  3.36000E-01  3.52000E-01  3.68000E-01  3.84000E-01
#           4.00000E-01  4.16000E-01  4.32000E-01  4.48000E-01  4.64000E-01
#           4.80000E-01  4.96000E-01  5.12000E-01  5.28000E-01  5.44000E-01
#           5.60000E-01  5.76000E-01  5.92000E-01  6.08000E-01  6.24000E-01
#           6.40000E-01  6.56000E-01  6.72000E-01  6.88000E-01  7.04000E-01
#           7.20000E-01  7.36000E-01  7.52000E-01  7.68000E-01  7.84000E-01
#           8.00000E-01  8.16000E-01  8.32000E-01  8.48000E-01  8.64000E-01
#           8.80000E-01  8.96000E-01  9.12000E-01  9.28000E-01  9.44000E-01
#           9.60000E-01  9.76000E-01  9.92000E-01  1.00800E+00  1.02400E+00
#           1.04000E+00  1.05600E+00  1.07200E+00  1.08800E+00  1.10400E+00
#           1.12000E+00  1.13600E+00  1.15200E+00  1.16800E+00  1.18400E+00
#           1.20000E+00  1.21600E+00  1.23200E+00  1.24800E+00  1.26400E+00
#           1.28000E+00  1.29600E+00  1.31200E+00  1.32800E+00  1.34400E+00
#           1.36000E+00  1.37600E+00  1.39200E+00  1.40800E+00  1.42400E+00
#           1.44000E+00  1.45600E+00  1.47200E+00  1.48800E+00  1.50400E+00
#           1.52000E+00  1.53600E+00  1.55200E+00  1.56800E+00  1.58400E+00
#           1.60000E+00
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =   98.47000      # minimum value of z-mesh points
     zmax =   98.49000      # maximum value of z-mesh points
#    zdel =  2.0000000E-02  # mesh width of z-mesh points
       nz =      1          # number of z-mesh points
#    data = ( z(i), i = 1, nz + 1 )
#           9.84700E+01  9.84900E+01
     unit =    0            # unit is [Gy/source]
   letmat =    0            # (D=0) mat ID for LET, 0:real mat, <0: electron for H2O
  dedxfnc =    0            # (D=0) user defined multiplier, 0(no), 1, 2
 material =  all            # (D=all) number of specific material
   output =  dose           # total deposit energy
  deposit =    0            # (D=0) 0-> total deposit dist, 1-> each process
     axis =     z           # axis of output
     file = bragg_pouch_rcilindJesus.out  # file name of output for the above axis
     part =  proton   
# kf/name :  2212     
   epsout =    1            # (D=0) generate eps file by ANGEL
   mother =  all            # (D=all) number of specific mother
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :         106 (  0)           0 (  0)         106 (  0)

#------------------------------------------------------------------------------
#newpage:
#   no. =  1   ir  =  1
#   r = (   0.0000E+00  -   1.6000E-02  )

x: z [cm]
y: Dose [Gy/source]      
p: xlin ylog afac(0.8) form(0.9)
h: n            x            y(proton  ),hh0l n 
#  z-lower      z-upper        proton    r.err 
   9.8470E+01   9.8490E+01   9.5155E-03  0.3080

#   sum over    1.6085E-05   9.5155E-03  0.3080

'no. =  1,  ir =  1'
msuc: {\huge Bragg peak in pouch}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.35}
wt: s(0.7)
\vspace{-3}
  rmin  &=&   0.0000E+00 [cm]
  rmax  &=&   1.6000E-02 [cm]
e:

