xmin = -6.0
xmax = 6.0
y-type = 2
ny = 1
ymin = -6.0
ymax = 6.0
z-type = 1
nz = 1
98.28 98.38

e-type = 3
ne = 100
emin = 0.01
emax = 25.0
part = proton neutron alpha photon positron
axis = eng
file = espectro_antes_pouch_M0.out
unit = 1
epsout = 1


