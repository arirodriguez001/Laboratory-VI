
$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$ MODELO A $$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$

$ Tallys para ver la geometria

[ T - T r a c k ]  $ flujo de protones a la altura del pouch

mesh = xyz
x-type = 2
nx = 25               
xmin = -4.
xmax = 4.
y-type = 2
ny = 60                  
ymin = -6.
ymax = 5.
z-type = 1
nz = 1
98.485 98.490             $ centro del pouch z= 98.480 +- 0.01 cm / para ver la cinta: 98.373  98.378 /98.485  98.49
part = proton
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = xy
file = track_xy_A.out
gshow = 1
epsout = 1

[ T - T r a c k ]off  $ flujo de particulas en yz

mesh = xyz
x-type = 1
nx = 1
0. 0.1
y-type = 2
ny = 150          
ymin = -10.
ymax = 10.
z-type = 2            
nz = 500
zmin = -10 
zmax = 110.

part = proton
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = yz
file = track_yz_A.out
gshow = 1
epsout = 1

[ T - T r a c k ]  $ para ver la guillotina en xz

mesh = xyz
x-type = 2
nx = 50
xmin = -4.
xmax = 4.
y-type = 1
ny = 1          
0. 0.1                   $-1.65 -1.70 guillotina
z-type = 2           
nz = 50
zmin = 95 
zmax = 105.

part = proton
e-type = 1
ne = 1
0.0 1000.0
unit = 1
axis = xz
file = track_xz_A.out
gshow = 1
epsout = 1


$$$$$$$$$$$$  perfiles de flujo a x e y cte (para hacer la cruz) $$$$$$$$$$$$$$$

[ T-Track ] off
    title = Perfil horizontal de flujo, y constante
    mesh = xyz

    x-type = 2
    xmin = -3.0
    xmax =  3.0
    nx = 120

    y-type = 2
    ymin = -0.2
    ymax =  0.2
    ny = 1

    z-type = 2
    zmin = 98.38
    zmax = 98.58
    nz = 1

    part = proton
    e-type = 1
ne = 1
0.0 1000.0
    axis = x
    file = perfil_flujo_x_ycte.out
    unit = 1
    gshow = 1
    epsout = 1

[ T-Track ] off
    title = Perfil vertical de flujo, x constante
    mesh = xyz

    x-type = 2
    xmin = -0.2
    xmax =  0.2
    nx = 1

    y-type = 2
    ymin = -3.0
    ymax =  3.0
    ny = 120

    z-type = 2
    zmin = 98.38
    zmax = 98.58
    nz = 1

    part = proton
    e-type = 1
ne = 1
0.0 1000.0
    axis = y
    file = perfil_flujo_y_xcte.out
    unit = 1
    gshow = 1
    epsout = 1

$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$


[ T - D e p o s i t ]  off  $ dosis depositada en profundidad

title = Bragg peak in pouch

mesh = r-z
r-type = 2
rmin = 0.0
rmax = 0.5
nr = 1

z-type = 2 
zmin = 97
zmax = 100           
nz = 100                    

part = proton
output = dose
unit = 0
axis = z
file = bragg_pouch_zA.out
epsout = 1

[ T - D e p o s i t ]  off  $ dosis radial en el pouch

title = Bragg peak in pouch, ahora con radio 1
mesh = r-z

r-type = 2
rmin = 0.0
rmax = 1.7     
nr = 100

z-type = 2
zmin = 98.38
zmax = 98.58
nz = 1

part = proton
output = dose
unit = 0
axis = r
file = bragg_pouch_rA.out
epsout = 1


[ T - Track ] off  $ espectro de energia por region

title = Espectro de energia
mesh = reg
reg = 510 600 6003
e-type = 2
ne = 100
emin = 1.0e-9
emax = 25.0
unit = 1
axis = eng
file = energy_pouch_M0.out
part = proton neutron alpha photon positron

[ T - Track ] off  $ para ver que particulas le llega al hamster

title = Espectro de energia
mesh = reg
reg = 700
e-type = 2
ne = 100
emin = 1.0e-9
emax = 25.0
unit = 1
axis = eng
file = energy_hamster_A.out
part = proton neutron alpha photon positron


