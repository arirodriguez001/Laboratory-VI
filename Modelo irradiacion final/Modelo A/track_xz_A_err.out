[ T-Track ]
    title = [t-track] in xyz mesh
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # x-mesh is linear given by xmin, xmax and nx
     xmin =  -4.000000      # minimum value of x-mesh points
     xmax =   4.000000      # maximum value of x-mesh points
#    xdel =  0.8000000      # mesh width of x-mesh points
       nx =     10          # number of x-mesh points
#    data = ( x(i), i = 1, nx + 1 )
#          -4.00000E+00 -3.20000E+00 -2.40000E+00 -1.60000E+00 -8.00000E-01
#           0.00000E+00  8.00000E-01  1.60000E+00  2.40000E+00  3.20000E+00
#           4.00000E+00
   y-type =    1            # y-mesh is given by the below data
       ny =      1          # number of y-mesh points
#    data = ( y(i), i = 1, ny + 1 )
            0.00000E+00  1.00000E-01
   z-type =    2            # z-mesh is linear given by zmin, zmax and nz
     zmin =   95.00000      # minimum value of z-mesh points
     zmax =   105.0000      # maximum value of z-mesh points
#    zdel =   1.000000      # mesh width of z-mesh points
       nz =     10          # number of z-mesh points
#    data = ( z(i), i = 1, nz + 1 )
#           9.50000E+01  9.60000E+01  9.70000E+01  9.80000E+01  9.90000E+01
#           1.00000E+02  1.01000E+02  1.02000E+02  1.03000E+02  1.04000E+02
#           1.05000E+02
   e-type =    1            # e-mesh is given by the below data
       ne =      1          # number of e-mesh points
#    data = ( e(i), i = 1, ne + 1 )
            0.00000E+00  1.00000E+03
     unit =    1            # unit is [1/cm^2/source]
 material =  all            # (D=all) number of specific material
  2D-type =    3            # 1:Cont, 2:Clust, 3:Color, 4:xyz, 5:mat, 6:Clust+Cont, 7:Col+Cont
     axis =      xz            # axis of output
     file = track_xz_A.out  # file name of output for the above axis
     part =  proton   
# kf/name :  2212     
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat 5:bmp style
    resol =    1            # (D=1) resolution of gshow or rshow
    width = 0.5000000       # (D=0.5) width of lines for gshow or rshow
   epsout =    1            # (D=0) generate eps file by ANGEL
#    used :        main (  %)        temp (  %)       total (  %)
#  memory :          30 (  0)           0 (  0)          30 (  0)

#------------------------------------------------------------------------------
#newpage:
#   no. =  1   ie  =  1   iy  =  1   part. = proton  
#   e = (   0.0000E+00  -   1.0000E+03  )
#   y = (   0.0000E+00  -   1.0000E-01  )

'no. =  1,  ie =  1,  iy =  1'
msuc: {\huge [t-track] in xyz mesh}
msdr: {\it plotted by \ANGEL \version}
msdl: {\it calculated by \PHITS  3.35}

x: z [cm]
y: x [cm]
set: c1[ 0.800] c2[ 1.006] c5[ 0.800] c6[ 0.925] c7[ 0.000] c8[ 0.100]
p: h2fs form[c1] xfac[c2] afac[c5] scal[c6] xorg[c7] yorg[c8] nosp
set: c3[1.0e-4] c4[1.0]
p: cmin[c3] cmax[c4]
p: dmin(1e-31)
p: zlog
p: xmin(  95.00000    ) xmax(  105.0000    )
p: ymin( -4.000000    ) ymax(  4.000000    )
#  nx =  10   nz =  10
# ( ( data(z,x), z = 1, nz ), x = nx, 1, -1 )

hc:  y =   3.600000     to  -3.600000     by  0.8000000     ; x =   95.50000     to   104.5000     by   1.000000     ;
  0.000E+00  0.000E+00  0.000E+00  0.000E+00  0.000E+00  0.000E+00  1.000E+00  1.000E+00  1.000E+00  1.000E+00
  0.000E+00  0.000E+00  0.000E+00  0.000E+00  0.000E+00  0.000E+00  0.000E+00  0.000E+00  0.000E+00  0.000E+00
  0.000E+00  0.000E+00  0.000E+00  0.000E+00  0.000E+00  0.000E+00  0.000E+00  0.000E+00  0.000E+00  0.000E+00
